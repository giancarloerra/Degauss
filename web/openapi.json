{
  "openapi": "3.1.0",
  "info": {"title": "Degauss Web Access", "version": "1", "description": "Local, frontend-owned API. Available only while Degauss is running. All identifiers are obtained from responses. Never retry a mutation after losing its acknowledgement. See docs/web-access.md for the complete command catalogue and native data contracts."},
  "servers": [{"url": "/"}],
  "security": [{"httpsSession": []}, {"httpSession": []}],
  "paths": {
    "/api/v1/login": {"post": {
      "operationId": "login", "security": [],
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["password"], "properties": {"password": {"type": "string", "format": "password"}, "remember": {"type": "boolean", "default": false}}}}}},
      "responses": {"200": {"description": "HttpOnly SameSite=Strict session cookie and CSRF token. HTTPS cookie is Secure.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}
    }},
    "/api/v1/session": {"get": {"operationId": "session", "responses": {"200": {"description": "Current session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/logout": {"post": {"operationId": "logout", "parameters": [{"$ref": "#/components/parameters/Csrf"}], "responses": {"200": {"description": "Session revoked, including the remembered server-side entry."}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/command": {"post": {
      "operationId": "command", "parameters": [{"$ref": "#/components/parameters/Csrf"}],
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Command"}}}},
      "responses": {"200": {"description": "Command-specific JSON result, or {job: integer}. Poll the job command for completion. A completed job contains result; a failed job contains error. State-changing settings commands return the new revision.", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}
    }},
    "/api/v1/upload/{target}": {"post": {
      "operationId": "uploadArtwork", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"name": "target", "in": "path", "required": true, "schema": {"type": "string"}, "description": "A registered game, system or category target ID, or entry: followed by a personal Home entry ID."}, {"name": "X-Degauss-Revision", "in": "header", "required": true, "schema": {"type": "string"}}],
      "requestBody": {"required": true, "content": {"image/png": {"schema": {"type": "string", "format": "binary", "maxLength": 16777216}}, "image/jpeg": {"schema": {"type": "string", "format": "binary", "maxLength": 16777216}}}},
      "responses": {"200": {"description": "Asynchronous upload job. Image decoding and native Gamelist installation happen before success."}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}}
    }},
    "/api/v1/media/{id}": {"get": {"operationId": "artwork", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Registered PNG/JPEG artwork. A filesystem path is never accepted."}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/events": {"get": {"operationId": "events", "responses": {"200": {"description": "Server-sent JSON state, job or resync events. Re-read state after resync. No mutation is replayed. Stream closes when Degauss exits.", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/openapi.json": {"get": {"operationId": "openapi", "responses": {"200": {"description": "This versioned specification."}, "401": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"httpsSession": {"type": "apiKey", "in": "cookie", "name": "__Host-degauss"}, "httpSession": {"type": "apiKey", "in": "cookie", "name": "degauss-http"}},
    "parameters": {"Csrf": {"name": "X-Degauss-CSRF", "in": "header", "required": true, "schema": {"type": "string"}, "description": "Token returned by login or session. Required for every POST, including read commands."}},
    "responses": {"Error": {"description": "Actionable failure. Nothing should be retried automatically. A durability error means the change was installed but its directory could not be flushed; re-read current state.", "content": {"application/json": {"schema": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}}}}},
    "schemas": {
      "Session": {"type": "object", "required": ["csrf", "encrypted"], "properties": {"csrf": {"type": "string"}, "encrypted": {"type": "boolean"}}},
      "Command": {"description": "Tagged command. Each command accepts only its documented fields. Nested native definitions are documented in docs/web-access.md. Unknown actions/fields are rejected.", "oneOf": [
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"enum":["state","web-settings","web-certificate-renew","ini-profiles","systems","collections","options","themes","controllers","scraper-settings","attract","history","favorite-folders","images"]}}},
        {"type":"object","required":["action","revision","config"],"additionalProperties":false,"properties":{"action":{"const":"web-settings-save"},"revision":{"type":"string"},"config":{"$ref":"#/components/schemas/WebConfig"},"password":{"type":["string","null"],"format":"password"}}},
        {"type":"object","required":["action","slot"],"additionalProperties":false,"properties":{"action":{"const":"ini-switch"},"slot":{"type":"integer","minimum":0,"maximum":3}}},
        {"type":"object","required":["action","system"],"additionalProperties":false,"properties":{"action":{"const":"browse"},"system":{"type":"string"},"folder":{"type":["string","null"]},"offset":{"type":"integer","minimum":0,"default":0},"limit":{"type":"integer","minimum":1,"maximum":200,"default":60},"search":{"type":"string","default":""},"filters":{"$ref":"#/components/schemas/Query"}}},
        {"type":"object","required":["action","id"],"additionalProperties":false,"properties":{"action":{"enum":["game","launch"]},"id":{"type":"string"}}},
        {"type":"object","required":["action","query"],"additionalProperties":false,"properties":{"action":{"const":"explore"},"query":{"$ref":"#/components/schemas/Query"},"offset":{"type":"integer","minimum":0,"default":0},"limit":{"type":"integer","minimum":1,"maximum":200,"default":60}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"enum":["home","home-artwork","scripts"]},"folder":{"type":["string","null"]}}},
        {"type":"object","required":["action","revision","edit"],"additionalProperties":false,"properties":{"action":{"const":"home-edit"},"revision":{"type":"string"},"edit":{"$ref":"#/components/schemas/HomeEdit"}}},
        {"type":"object","required":["action","revision","name","query"],"additionalProperties":false,"properties":{"action":{"const":"collection-save"},"revision":{"type":"string"},"id":{"type":["string","null"]},"name":{"type":"string"},"query":{"$ref":"#/components/schemas/Query"}}},
        {"type":"object","required":["action","revision","id"],"additionalProperties":false,"properties":{"action":{"enum":["collection-delete","view-delete"]},"revision":{"type":"string"},"id":{"type":"string"}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"const":"views"},"target":{"type":["string","null"]}}},
        {"type":"object","required":["action","revision","definition"],"additionalProperties":false,"properties":{"action":{"const":"view-save"},"revision":{"type":"string"},"id":{"type":["string","null"]},"definition":{"$ref":"#/components/schemas/View"}}},
        {"type":"object","required":["action","revision","view"],"additionalProperties":false,"properties":{"action":{"const":"view-assign"},"revision":{"type":"string"},"target":{"type":["string","null"]},"view":{"type":"string"}}},
        {"type":"object","required":["action","revision","kind"],"additionalProperties":false,"properties":{"action":{"const":"reset"},"revision":{"type":"string"},"kind":{"enum":["view-selections","hidden"]}}},
        {"type":"object","required":["action","target"],"additionalProperties":false,"properties":{"action":{"const":"folder-options"},"target":{"type":"string"}}},
        {"type":"object","required":["action","revision","target","preferences"],"additionalProperties":false,"properties":{"action":{"const":"folder-options-save"},"revision":{"type":"string"},"target":{"type":"string"},"preferences":{"$ref":"#/components/schemas/FolderPreferences"}}},
        {"type":"object","required":["action","revision","target","hidden"],"additionalProperties":false,"properties":{"action":{"const":"hide"},"revision":{"type":"string"},"target":{"type":"string"},"hidden":{"type":"boolean"}}},
        {"type":"object","required":["action","revision","name","text"],"additionalProperties":false,"properties":{"action":{"const":"theme-save"},"revision":{"type":"string"},"name":{"type":"string"},"text":{"type":"string"},"replace":{"type":"boolean","default":false}}},
        {"type":"object","required":["action","revision","name"],"additionalProperties":false,"properties":{"action":{"const":"theme-delete"},"revision":{"type":"string"},"name":{"type":"string"}}},
        {"type":"object","required":["action","revision"],"additionalProperties":false,"properties":{"action":{"const":"theme-select"},"revision":{"type":"string"},"name":{"type":["string","null"]}}},
        {"type":"object","required":["action","revision","values"],"additionalProperties":false,"properties":{"action":{"const":"scraper-settings-save"},"revision":{"type":"string"},"values":{"type":"object","description":"Editable settings returned by scraper-settings. Retain provider-specific native field types."},"password":{"type":["string","null"],"format":"password"},"accept_plaintext_storage":{"type":"boolean","default":false}}},
        {"type":"object","required":["action","game","term"],"additionalProperties":false,"properties":{"action":{"const":"scraper-search"},"game":{"type":"string"},"term":{"type":"string"}}},
        {"type":"object","required":["action","match_id"],"additionalProperties":false,"properties":{"action":{"const":"scraper-preview"},"match_id":{"type":"string"}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"const":"scrape"},"target":{"type":["string","null"]},"match_id":{"type":["string","null"]}}},
        {"type":"object","required":["action","system"],"additionalProperties":false,"properties":{"action":{"const":"game-data"},"system":{"type":"string"}}},
        {"type":"object","required":["action","system","picture_type"],"additionalProperties":false,"properties":{"action":{"const":"game-data-locations"},"system":{"type":"string"},"picture_type":{"enum":["box-art","screenshot","title-screen"]},"directory":{"type":["string","null"]}}},
        {"type":"object","required":["action","revision","system","source"],"additionalProperties":false,"properties":{"action":{"const":"game-data-save"},"revision":{"type":"string"},"system":{"type":"string"},"source":{"enum":["automatic","gamelist","artwork-pack"]},"location":{"type":["string","null"]},"picture_type":{"enum":["box-art","screenshot","title-screen",null]}}},
        {"type":"object","required":["action","game"],"additionalProperties":false,"properties":{"action":{"const":"pack-matches"},"game":{"type":"string"},"search":{"type":"string","default":""}}},
        {"type":"object","required":["action","revision","game"],"additionalProperties":false,"properties":{"action":{"const":"pack-match-save"},"revision":{"type":"string"},"game":{"type":"string"},"choice":{"type":["string","null"]}}},
        {"type":"object","required":["action","revision","id","profile"],"additionalProperties":false,"properties":{"action":{"const":"controller-save"},"revision":{"type":"string"},"id":{"type":"string"},"profile":{"$ref":"#/components/schemas/ControllerProfile"}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"const":"cores"},"category":{"type":["string","null"]}}},
        {"type":"object","required":["action","system"],"additionalProperties":false,"properties":{"action":{"const":"core-choices"},"system":{"type":"string"},"game":{"type":["string","null"]}}},
        {"type":"object","required":["action","revision","system"],"additionalProperties":false,"properties":{"action":{"const":"core-select"},"revision":{"type":"string"},"system":{"type":"string"},"game":{"type":["string","null"]},"family":{"type":["string","null"]},"version":{"type":["string","null"]}}},
        {"type":"object","required":["action","id"],"additionalProperties":false,"properties":{"action":{"enum":["job","cancel"]},"id":{"type":"integer","minimum":1}}},
        {"type":"object","required":["action","revision","option","delta"],"additionalProperties":false,"properties":{"action":{"const":"option-adjust"},"revision":{"type":"string"},"option":{"type":"string"},"delta":{"enum":[-1,1]}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"const":"random"},"query":{"$ref":"#/components/schemas/Query"},"folder":{"type":["string","null"]},"favorites_only":{"type":"boolean","default":false}}},
        {"type":"object","required":["action","button"],"additionalProperties":false,"properties":{"action":{"const":"remote"},"button":{"enum":["up","down","left","right","select","back","actions","menu"]}}},
        {"type":"object","required":["action","pin"],"additionalProperties":false,"properties":{"action":{"const":"unlock"},"pin":{"type":"string","format":"password"}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"const":"rebuild"},"system":{"type":["string","null"]}}},
        {"type":"object","required":["action"],"additionalProperties":false,"properties":{"action":{"const":"core-updates"},"refresh":{"type":"boolean","default":false},"begin":{"type":"boolean","default":false}}},
        {"type":"object","required":["action","key"],"additionalProperties":false,"properties":{"action":{"const":"core-update"},"key":{"type":"string"}}},
        {"type":"object","required":["action","snapshot"],"additionalProperties":false,"properties":{"action":{"const":"core-updates-seen"},"snapshot":{"type":"string"}}},
        {"type":"object","required":["action","game"],"additionalProperties":false,"properties":{"action":{"const":"favorite-add"},"game":{"type":"string"},"folder":{"type":["string","null"]},"name":{"type":["string","null"]}}},
        {"type":"object","required":["action","game"],"additionalProperties":false,"properties":{"action":{"const":"favorite-remove"},"game":{"type":"string"}}},
        {"type":"object","required":["action","name"],"additionalProperties":false,"properties":{"action":{"const":"favorite-folder-create"},"name":{"type":"string"}}},
        {"type":"object","required":["action","folder","name"],"additionalProperties":false,"properties":{"action":{"const":"favorite-folder-rename"},"folder":{"type":"string"},"name":{"type":"string"}}},
        {"type":"object","required":["action","folder"],"additionalProperties":false,"properties":{"action":{"const":"favorite-folder-delete"},"folder":{"type":"string"}}},
        {"type":"object","required":["action","revision","target"],"additionalProperties":false,"properties":{"action":{"const":"image-choose"},"revision":{"type":"string"},"target":{"type":"string"},"image":{"type":["string","null"]}}}
      ]},
      "WebConfig": {"type":"object","additionalProperties":false,"properties":{"mode":{"enum":["off","https","http"],"default":"off"},"port":{"type":"integer","minimum":1024,"maximum":65535,"default":8443}}},
      "Criterion": {"oneOf":[{"const":"Unknown"},{"type":"object","required":["Known"],"properties":{"Known":{"type":"object","required":["label","key"],"properties":{"label":{"type":"string"},"key":{"type":"string"}}}}}]},
      "Query": {"type":"object","properties":{"title":{"type":"string","default":""},"category":{"type":["string","null"]},"system":{"type":["string","null"]},"decade":{"oneOf":[{"type":"null"},{"$ref":"#/components/schemas/Criterion"}]},"fields":{"type":"object","propertyNames":{"enum":["Genre","Year","Players","Language","Developer","Publisher"]},"additionalProperties":{"$ref":"#/components/schemas/Criterion"}}}},
      "View": {"type":"object","required":["name","template","panels","columns","rows"],"properties":{"name":{"type":"string"},"template":{"enum":["columns","split-right","split-left","stacked"]},"panels":{"type":"array","minItems":2,"maxItems":3,"items":{"enum":["list","artwork","short-information","full-information"]},"description":"Exactly one list; two panels except split templates which need three."},"columns":{"type":"integer","minimum":20,"maximum":80},"rows":{"type":"integer","minimum":20,"maximum":80}}},
      "FolderPreferences": {"type":"object","properties":{"screen_rotation":{"enum":["off","clockwise","counter-clockwise",null]},"folders_last":{"type":["boolean","null"]},"game_name_display":{"type":["string","null"],"description":"Native game-name mode. Omit/null each field independently to follow global."}}},
      "ControllerProfile": {"type":"object","properties":{"custom":{"type":"boolean","default":false},"bindings":{"type":"object","description":"Complete native role map returned by controllers, not per-control inheritance. Capture unknown physical inputs on MiSTer.","additionalProperties":{"type":"array","items":{"type":"object","required":["code","label"],"properties":{"code":{"type":"integer","minimum":0,"maximum":65535},"label":{"type":"string"}}}}}}},
      "HomeEdit": {"oneOf":[
        {"type":"object","additionalProperties":false,"required":["operation","name","target"],"properties":{"operation":{"const":"add"},"name":{"type":"string"},"target":{"type":"string"},"parent":{"type":["string","null"]}}},
        {"type":"object","additionalProperties":false,"required":["operation","name"],"properties":{"operation":{"const":"folder"},"name":{"type":"string"},"parent":{"type":["string","null"]}}},
        {"type":"object","additionalProperties":false,"required":["operation","id","name"],"properties":{"operation":{"const":"rename"},"id":{"type":"string"},"name":{"type":"string"}}},
        {"type":"object","additionalProperties":false,"required":["operation","id"],"properties":{"operation":{"const":"remove"},"id":{"type":"string"}}},
        {"type":"object","additionalProperties":false,"required":["operation","id"],"properties":{"operation":{"const":"move"},"id":{"type":"string"},"parent":{"type":["string","null"]}}},
        {"type":"object","additionalProperties":false,"required":["operation","keys"],"properties":{"operation":{"const":"reorder"},"folder":{"type":["string","null"]},"keys":{"type":"array","items":{"type":"string"}}}},
        {"type":"object","additionalProperties":false,"required":["operation","key","visible"],"properties":{"operation":{"const":"visibility"},"key":{"type":"string"},"visible":{"type":"boolean"}}}
      ]}
    }
  }
}
