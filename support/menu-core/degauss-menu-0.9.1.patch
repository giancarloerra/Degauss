diff --git a/tests/run-framebuffer-port-tests.py b/tests/run-framebuffer-port-tests.py
new file mode 100644
index 0000000..89badd2
--- /dev/null
+++ b/tests/run-framebuffer-port-tests.py
@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+"""Simulate DDR routing, IO Direct and the native 20 MHz timing units."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+import re
+
+root = Path(__file__).resolve().parents[1]
+top = (root / "sys/sys_top.v").read_text()
+menu = (root / "menu.sv").read_text()
+pll = (root / "rtl/pll/pll_0002.v").read_text()
+assert '.output_clock_frequency1("25.000000 MHz")' in pll
+assert '.number_of_clocks(2)' in pll
+assert '.MENU_NATIVE(native_fb_active)' in top
+assert top.count('.inclk({clk_vid, hdmi_clk_out, 2\'b00})') == 2
+assert '.o_ce(native_fb_ce)' in top
+assert '.ce_in(native_fb_active ? native_fb_ce : ce_pix)' in top
+assert '.show(FB & ~MENU_NATIVE)' in menu
+assert 'fb_req <= FB & ~MENU_NATIVE;' in menu
+assert 'ddr_pause = (FB & ~MENU_NATIVE) | fb_own;' in menu
+assert 'assign DDRAM_BURSTCNT = 1;' in (root / "rtl/ddram.sv").read_text()
+ascal = (root / "sys/ascal.vhd").read_text()
+for port in ("o_fb_ena", "o_fb_hsize", "o_fb_vsize", "o_fb_format", "o_fb_base", "o_fb_stride"):
+    assert re.search(r"\b" + port + r"\s*:\s*IN\b", ascal), port
+
+start = top.index("wire [28:0] menu_ram_address;")
+end = top.index("\nwire  [23:0] hdmi_data;", start)
+production = top[start:end]
+prefix = r'''
+module arbiter_tb;
+reg ram_clk = 0;
+always #5 ram_clk = ~ram_clk;
+reg reset = 1;
+reg LFB_EN = 0, LFB_NATIVE = 0, vga_scaler = 0;
+reg ram_waitrequest = 0, ram_readdatavalid = 0;
+wire [28:0] ram_address;
+wire [7:0] ram_burstcount, ram_byteenable;
+wire [63:0] ram_writedata;
+wire ram_read, ram_write;
+reg [28:0] menu_address = 100, native_address = 200;
+reg [7:0] menu_burst = 2, native_burst = 3;
+reg menu_read = 0, menu_write = 0, native_read = 0;
+'''
+checks = r'''
+assign menu_ram_address = menu_address;
+assign native_fb_address = native_address;
+assign menu_ram_burstcount = menu_burst;
+assign native_fb_burstcount = native_burst;
+assign menu_ram_read = menu_read;
+assign menu_ram_write = menu_write;
+assign native_fb_read = native_read;
+assign menu_ram_writedata = 0;
+assign menu_ram_byteenable = 8'hff;
+assign native_fb_byteenable = 8'hff;
+task tick;
+begin @(posedge ram_clk); #1; end
+endtask
+task falling;
+begin @(negedge ram_clk); end
+endtask
+initial begin
+    tick; falling; reset = 0;
+    menu_read = 1;
+    tick;
+    if (!ram_read || ram_address != 100 || menu_ram_waitrequest)
+        $fatal(1,"Stock framebuffer read not granted");
+    tick; falling; menu_read = 0;
+    LFB_EN = 1; LFB_NATIVE = 1; native_read = 1;
+    // The new native request cannot steal an already-issued stock burst.
+    ram_readdatavalid = 1;
+    #1;
+    if (!menu_ram_readdatavalid || native_fb_readdatavalid || ram_read)
+        $fatal(1,"Stock response routed to the other reader");
+    tick;
+    if (ram_owner != RAM_MENU_READ) $fatal(1,"Stock burst ended early");
+    tick; falling; ram_readdatavalid = 0;
+    tick;
+    if (!ram_read || ram_address != 200 || native_fb_waitrequest)
+        $fatal(1,"Native reader not granted after stock burst");
+    // Hold the request under memory backpressure.
+    falling; ram_waitrequest = 1;
+    tick;
+    if (!ram_read || ram_address != 200 || ram_owner != RAM_NATIVE_REQUEST)
+        $fatal(1,"Native request changed under backpressure");
+    falling; ram_waitrequest = 0;
+    tick; falling; native_read = 0; menu_write = 1; menu_burst = 1;
+    ram_readdatavalid = 1;
+    #1;
+    if (!native_fb_readdatavalid || menu_ram_readdatavalid || ram_write)
+        $fatal(1,"Native response routed to the clearing writer");
+    tick; tick;
+    if (ram_owner != RAM_NATIVE_READ) $fatal(1,"Native burst ended early");
+    tick; falling; ram_readdatavalid = 0;
+    tick;
+    if (!ram_write || ram_read) $fatal(1,"Clearing did not resume");
+    tick; falling; menu_write = 0;
+    // An inactive native path must not acquire the port.
+    LFB_NATIVE = 0; native_read = 1;
+    tick; tick;
+    if (ram_read || ram_write) $fatal(1,"Inactive native reader acquired DDR");
+    $display("Stock/native framebuffer arbitration passed");
+    $finish;
+end
+endmodule
+'''
+with tempfile.TemporaryDirectory(prefix="menu-framebuffer-port-") as temporary:
+    unit = Path(temporary) / "arbiter.sv"
+    binary = Path(temporary) / "arbiter"
+    unit.write_text(prefix + production + checks)
+    subprocess.run(["iverilog", "-g2012", "-s", "arbiter_tb", "-o", str(binary), str(unit)], check=True)
+    subprocess.run(["vvp", str(binary)], check=True)
+    start = top.index("reg [2:0] native_ce_phase = 0;")
+    end = top.index("\nreg [11:0] native_htotal", start)
+    timing = r'''
+module rate_tb;
+reg clk_vid = 0;
+always #20 clk_vid = ~clk_vid;
+'''+ top[start:end] + r'''
+integer clocks = 0, pixels = 0, edge_clocks;
+integer target, i;
+initial begin
+    // The production enable advances exactly 20 times per 25 MHz microsecond.
+    repeat (100) begin
+        @(posedge clk_vid);
+        if (native_fb_ce) pixels = pixels + 1;
+    end
+    if (pixels != 80) $fatal(1,"Native pixel rate changed");
+    // Measure intervals between enabled edges, not from an arbitrary
+    // sample that can start during the four-in-five cadence's idle clock.
+    @(posedge clk_vid);
+    while (!native_fb_ce) @(posedge clk_vid);
+    // Defaults, a custom modeline and the full previously valid range.
+    // Quantization is bounded to one 25 MHz clock, with no accumulated drift.
+    for (i = 0; i < 3; i = i + 1) begin
+        target = i == 0 ? 1276 : i == 1 ? 1186 : 4095;
+        pixels = 0; clocks = 0;
+        while (pixels < target * 4) begin
+            @(posedge clk_vid); clocks = clocks + 1;
+            if (native_fb_ce) pixels = pixels + 1;
+        end
+        edge_clocks = target * 5;
+        if (clocks != edge_clocks) $fatal(1,"Native timing units changed");
+    end
+    $display("20 MHz native timing units on 25 MHz clock passed");
+    $finish;
+end
+endmodule
+'''
+    unit.write_text(timing)
+    subprocess.run(["iverilog", "-g2012", "-s", "rate_tb", "-o", str(binary), str(unit)], check=True)
+    subprocess.run(["vvp", str(binary)], check=True)
+    # Exercise the actual IO Direct mux with its declarations after use,
+    # as in sys_top. Every colour byte must survive, not an implicit bit.
+    start = top.index("if(vga_fb && direct_video && yc_en) begin")
+    end = top.index("\n\tend", start) + len("\n\tend")
+    assert top.index("wire [23:0] vgas_yc_o;") < start
+    mux = r'''
+module mux_tb;
+reg clk = 0;
+always #5 clk = ~clk;
+reg vga_fb = 1, direct_video = 1, yc_en = 1, csync_en = 1;
+reg hs, vs, de;
+reg [23:0] d;
+wire [23:0] vgas_yc_o;
+wire vgas_yc_hs, vgas_yc_vs, vgas_yc_cs, vgas_yc_de;
+always @(posedge clk) begin
+    hs <= 0; vs <= 0; de <= 0; d <= 0;
+'''+ top[start:end] + r'''
+end
+assign vgas_yc_o = 24'ha1b2c3;
+assign {vgas_yc_hs, vgas_yc_cs, vgas_yc_vs, vgas_yc_de} = 4'b0111;
+initial begin
+    @(posedge clk); #1;
+    if (d != 24'ha1b2c3 || !hs || !vs || !de)
+        $fatal(1,"IO Direct did not select the complete Y/C signal");
+    @(negedge clk); yc_en = 0;
+    @(posedge clk); #1;
+    if (d != 0 || hs || vs || de)
+        $fatal(1,"IO Direct changed the non-Y/C path");
+    $display("IO Direct Y/C routing passed");
+    $finish;
+end
+endmodule
+'''
+    unit.write_text(mux)
+    subprocess.run(["iverilog", "-g2012", "-Wall", "-s", "mux_tb", "-o", str(binary), str(unit)], check=True)
+    subprocess.run(["vvp", str(binary)], check=True)
