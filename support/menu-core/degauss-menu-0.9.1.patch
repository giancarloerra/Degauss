@@ -0,0 +1,33 @@
+module yc_luma_setup_tb;
+	reg clk = 0;
+	always #5 clk = ~clk;
+
+	reg [23:0] din = 0;
+	wire [23:0] dout;
+	wire hsync_o, vsync_o, csync_o, de_o;
+
+	yc_out dut (
+		.clk(clk), .PHASE_INC(40'd0), .PAL_EN(1'b0), .CVBS(1'b0),
+		.COLORBURST_RANGE(17'd0), .hsync(1'b0), .vsync(1'b0),
+		.csync(1'b0), .de(1'b1), .din(din), .dout(dout),
+		.hsync_o(hsync_o), .vsync_o(vsync_o), .csync_o(csync_o), .de_o(de_o)
+	);
+
+	integer sample;
+	reg [15:0] expected;
+	initial begin
+		for (sample = 0; sample < 1024; sample = sample + 1) begin
+			@(negedge clk);
+			din = {8'(sample), 8'(sample * 73), 8'(sample * 149)};
+			@(posedge clk);
+			#1;
+			if (sample > 12) begin
+				expected = dut.luma_d4 * 16'd237;
+				if (dut.luma_setup_scaled !== expected)
+					$fatal(1, "Luma setup changed value or pipeline alignment");
+			end
+		end
+		$display("Luma setup pipeline passed");
+		$finish;
+	end
+endmodule
