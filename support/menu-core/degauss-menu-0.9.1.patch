@@ -0,0 +1,37 @@
+module yc_output_tb;
+	reg clk = 0;
+	always #5 clk = ~clk;
+	reg [23:0] din = 0;
+	reg de = 0, hs = 0, vs = 0;
+	reg pal = 0, cvbs = 0;
+	wire [23:0] dout;
+	wire hsync_o, vsync_o, csync_o, de_o;
+	yc_out dut (
+		.clk(clk), .PHASE_INC(40'd0), .PAL_EN(pal), .CVBS(cvbs),
+		.COLORBURST_RANGE(17'd0), .hsync(hs), .vsync(vs),
+		.csync(hs), .de(de), .din(din), .dout(dout),
+		.hsync_o(hsync_o), .vsync_o(vsync_o), .csync_o(csync_o), .de_o(de_o)
+	);
+	reg [7:0] expected_y, expected_c;
+	reg expected_de, expected_hs, expected_vs;
+	integer sample;
+	initial begin
+		for (sample = 0; sample < 1024; sample = sample + 1) begin
+			@(negedge clk);
+			din = {8'(sample), 8'(sample * 73), 8'(sample * 149)};
+			de = sample[4]; hs = sample[5]; vs = sample[6];
+			pal = sample[8]; cvbs = sample[9];
+			expected_y = cvbs ? dut.cvbs_out : dut.yc_luma;
+			expected_c = cvbs ? 8'd0 : dut.chroma;
+			expected_de = dut.de_dly6;
+			expected_hs = dut.hsync_dly[6];
+			expected_vs = dut.vsync_dly[6];
+			@(posedge clk); #1;
+			if (sample > 12 && (dout !== {expected_c, expected_y, 8'd0} ||
+				de_o !== expected_de || hsync_o !== expected_hs || vsync_o !== expected_vs))
+				$fatal(1,"Y/C data and sync lost their pipeline alignment");
+		end
+		$display("PAL/NTSC Y/C and CVBS output alignment passed");
+		$finish;
+	end
+endmodule
