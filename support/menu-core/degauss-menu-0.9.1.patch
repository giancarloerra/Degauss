+++ b/tests/run-native-timing-tests.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Simulate the production framebuffer command, including its extra timing words."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = (root / "sys/sys_top.v").read_text()
+start = source.index("case(cnt[4:0])", source.index("if(cmd == 'h2F)"))
+end = source.index("endcase", start) + len("endcase")
+production = source[start:end]
+prefix = r'''
+module timing_tb;
+reg clk = 0;
+always #5 clk = ~clk;
+reg [7:0] cnt = 0;
+reg [15:0] io_din = 0;
+reg LFB_EN = 0, LFB_FLT = 0, LFB_NATIVE = 0;
+reg [5:0] LFB_FMT = 0;
+reg [31:0] LFB_BASE = 0;
+reg [11:0] LFB_WIDTH = 0, LFB_HEIGHT = 0;
+reg [11:0] LFB_HMIN = 0, LFB_HMAX = 0, LFB_VMIN = 0, LFB_VMAX = 0;
+reg [13:0] LFB_STRIDE = 0;
+reg [11:0] native_htotal = 0, native_hsstart = 0, native_hsend = 0, native_hdisp = 0;
+reg [11:0] native_vtotal = 0, native_vsstart = 0, native_vsend = 0, native_vdisp = 0;
+always @(posedge clk) begin
+'''
+checks = r'''
+end
+task word(input [7:0] index, input [15:0] value);
+begin
+    @(negedge clk); cnt = index; io_din = value;
+    @(posedge clk); #1;
+end
+endtask
+integer i;
+initial begin
+    // The original ten-word command must keep its original meaning.
+    word(0, 16'ha005); word(1, 16'h1234); word(2, 16'h2200);
+    word(3,352); word(4,240); word(5,0); word(6,1919);
+    word(7,0); word(8,1079); word(9,1408);
+    if (!LFB_EN || !LFB_NATIVE || LFB_FMT != 5 ||
+        LFB_BASE != 32'h22001234 || LFB_WIDTH != 352 ||
+        LFB_HEIGHT != 240 || LFB_STRIDE != 1408 || native_vtotal != 0)
+        $fatal(1,"Legacy framebuffer command changed");
+    word(10,1000); word(11,840); word(12,920); word(13,800);
+    word(14,262); word(15,243); word(16,246); word(17,240);
+    if (native_htotal != 1000 || native_hsstart != 840 ||
+        native_hsend != 920 || native_hdisp != 800 ||
+        native_vtotal != 262 || native_vsstart != 243 ||
+        native_vsend != 246 || native_vdisp != 240)
+        $fatal(1,"Timing words did not reach the native reader");
+    if (!LFB_EN || !LFB_NATIVE || LFB_BASE != 32'h22001234)
+        $fatal(1,"Words 16/17 wrapped onto framebuffer control/address");
+    for (i = 10; i < 18; i = i + 1) word(i,0);
+    if (native_vtotal != 0 || native_htotal != 0)
+        $fatal(1,"Default native timing was not restored");
+    $display("Native timing command passed");
+    $finish;
+end
+endmodule
+'''
+with tempfile.TemporaryDirectory(prefix="degauss-native-timing-") as temporary:
+    bench = Path(temporary) / "timing.sv"
+    binary = Path(temporary) / "timing"
+    bench.write_text(prefix + production + checks)
+    subprocess.run(["iverilog", "-g2012", "-s", "timing_tb", "-o", str(binary),
+                    str(bench)], check=True)
+    subprocess.run(["vvp", str(binary)], check=True)
