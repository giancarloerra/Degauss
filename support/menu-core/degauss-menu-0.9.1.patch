+localparam [2:0] RAM_IDLE           = 3'd0;
+localparam [2:0] RAM_MENU_REQUEST   = 3'd1;
+localparam [2:0] RAM_MENU_READ      = 3'd2;
+localparam [2:0] RAM_NATIVE_REQUEST = 3'd3;
+localparam [2:0] RAM_NATIVE_READ    = 3'd4;
+reg [2:0] ram_owner = RAM_IDLE;
+reg [7:0] ram_reads_remaining = 0;
+
+wire ram_menu_selected = ram_owner == RAM_MENU_REQUEST;
+wire ram_native_selected = ram_owner == RAM_NATIVE_REQUEST;
+
+assign ram_address = ram_native_selected ? native_fb_address : menu_ram_address;
+assign ram_burstcount = ram_native_selected ? native_fb_burstcount : menu_ram_burstcount;
+assign ram_byteenable = ram_native_selected ? native_fb_byteenable : menu_ram_byteenable;
+assign ram_writedata = menu_ram_writedata;
+assign ram_read = ram_native_selected ? native_fb_read :
+                  ram_menu_selected ? menu_ram_read : 1'b0;
+assign ram_write = ram_menu_selected & menu_ram_write;
+assign menu_ram_waitrequest = ram_waitrequest | ~ram_menu_selected;
+assign native_fb_waitrequest = ram_waitrequest | ~ram_native_selected;
+assign menu_ram_readdatavalid = ram_readdatavalid & (ram_owner == RAM_MENU_READ);
+assign native_fb_readdatavalid = ram_readdatavalid & (ram_owner == RAM_NATIVE_READ);
+
+always @(posedge ram_clk) begin
+	if(reset) begin
+		ram_owner <= RAM_IDLE;
+		ram_reads_remaining <= 0;
+	end
+	else begin
+		case(ram_owner)
+			RAM_IDLE: begin
+				if(native_fb_active && native_fb_read) ram_owner <= RAM_NATIVE_REQUEST;
+				else if(menu_ram_read || menu_ram_write) ram_owner <= RAM_MENU_REQUEST;
+			end
+
+			RAM_MENU_REQUEST: begin
+				if(!(menu_ram_read || menu_ram_write)) ram_owner <= RAM_IDLE;
+				else if(!ram_waitrequest) begin
+					if(menu_ram_read) begin
+						ram_reads_remaining <= menu_ram_burstcount;
+						ram_owner <= RAM_MENU_READ;
+					end
+					else ram_owner <= RAM_IDLE;
+				end
+			end
+
+			RAM_MENU_READ: if(ram_readdatavalid) begin
+				if(ram_reads_remaining <= 1) ram_owner <= RAM_IDLE;
+				else ram_reads_remaining <= ram_reads_remaining - 1'd1;
+			end
+
+			RAM_NATIVE_REQUEST: begin
+				if(!native_fb_active || !native_fb_read) ram_owner <= RAM_IDLE;
+				else if(!ram_waitrequest) begin
+					ram_reads_remaining <= native_fb_burstcount;
+					ram_owner <= RAM_NATIVE_READ;
+				end
+			end
+
+			RAM_NATIVE_READ: if(ram_readdatavalid) begin
+				if(ram_reads_remaining <= 1) ram_owner <= RAM_IDLE;
+				else ram_reads_remaining <= ram_reads_remaining - 1'd1;
+			end
+
+			default: ram_owner <= RAM_IDLE;
+		endcase
+	end
+end
 
