// Degauss.
//
// Everything is drawn inside a safe rectangle, because a CRT crops the edges
// of the picture and a interface that assumes it owns every pixel forces the
// user to turn on underscan. The insets come from the config.
//
// Deliberately plain: no gradients, shadows, animations or rounded corners.
// Each of those costs the software renderer real time on every frame.

// The second typeface. Importing a font file is what bakes its glyphs into
// the binary; the first one is named by build.rs, which also makes it the one
// the renderer falls back to.
import "../assets/fonts/Px437_DOS-V_re_JPN12.ttf";
import "../assets/fonts/RobotoCondensed-Bold.ttf";
import "../assets/fonts/Tamzen6x12b.ttf";

// Which characters get glyphs. Written by build.rs, because the answer is
// "whatever the two fonts above can draw" and that is read off the font
// files rather than written down.
import { Charset } from "charset.slint";

// A title that is elided when it is not the one you are looking at, and
// walks itself sideways when it is.
//
// A list of games is full of names longer than the column: "Teenage Mutant
// Ninja Turtles - Turtles in Time (USA)" against a third of a 640 pixel
// screen. Eliding alone hides exactly the part that distinguishes one
// version from another, which is usually at the end.
//
// It waits before moving. The wait is what makes it readable rather than
// restless: scrolling through a list, every title would otherwise be in
// motion the moment it was passed.
component ScrollingTitle inherits Rectangle {
    in property <string> text;
    in property <color> text-color;
    in property <length> font-size;
    in property <bool> active;
    in property <bool> at-end;
    in property <TextHorizontalAlignment> align: left;
    /// Milliseconds per pixel travelled, and the longest it may take.
    /// A description is read while it moves and wants half the pace of a
    /// title, which is only being identified.
    in property <float> ms-per-px: 22;
    in property <duration> travel-cap: 1400ms;

    clip: true;

    txt := Text {
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        height: parent.height;
        // Given its full width the text is not elided, and can be walked
        // sideways instead. Given the box width it elides as usual.
        width: root.active && self.preferred-width > parent.width
            ? self.preferred-width
            : parent.width;
        overflow: elide;
        x: root.active && root.at-end && self.preferred-width > parent.width
            ? parent.width - self.preferred-width
            : 0px;
        // A speed, not a duration. Giving every line the same 1.4 s made a
        // long description tear past while a short title ambled, because
        // the one with further to go had to go faster. Capped, so the
        // longest line still turns round within the shared timer's period.
        animate x {
            duration: min(root.travel-cap, max(300ms,
                (max(0px, txt.preferred-width - root.width) / 1px) * root.ms-per-px * 1ms));
            easing: linear;
        }
    }
}

// The original wordmark stays fully visible. The second copy adds a flat
// colour from zero percent (original artwork) to 100 percent (monochrome).
component BlendedLogo inherits Rectangle {
    in property <color> tint: transparent;
    in property <float> tint-mix: 1.0;
    in property <bool> tint-enabled: false;

    Image {
        source: @image-url("../assets/degauss-logo.png");
        image-fit: contain;
        width: parent.width;
        height: parent.height;
    }
    Image {
        visible: root.tint-enabled;
        source: @image-url("../assets/degauss-logo.png");
        colorize: root.tint;
        opacity: root.tint-mix;
        image-fit: contain;
        width: parent.width;
        height: parent.height;
    }
}

struct DetailLine {
    label: string,
    value: string,
}

// The picture, and under it what the gamelist knows, a line each. Any line
// too long for the width walks sideways; the rest sit still. They all move
// together because they share one timer, which reads as the panel breathing
// rather than as six things fidgeting.
component DetailPanel inherits Rectangle {
    in property <[DetailLine]> lines;
    in property <length> font-size;
    in property <length> line-height;
    in property <length> pad;
    in property <color> text-color;
    in property <color> label-color;
    in property <bool> at-end;
    in property <float> ms-per-px;
    in property <duration> travel-cap;

    // The longest label there is, measured rather than guessed, so every
    // value starts at the same place down the column. Never drawn.
    gauge := Text {
        text: "Lang:";
        font-size: root.font-size;
        visible: false;
    }

    VerticalLayout {
        alignment: start;
        spacing: 0px;
        for line in root.lines: Rectangle {
            height: root.line-height;

            Text {
                text: line.label;
                color: root.label-color;
                font-size: root.font-size;
                vertical-alignment: center;
                x: 0;
                y: 0;
                width: gauge.preferred-width;
                height: parent.height;
            }

            // Only the value moves. A label that walks away from its own
            // value is unreadable, and there is nothing to read in it
            // anyway: it says the same thing every time.
            ScrollingTitle {
                x: gauge.preferred-width + root.pad;
                y: 0;
                width: parent.width - gauge.preferred-width - root.pad;
                height: parent.height;
                text: line.value;
                text-color: root.text-color;
                font-size: root.font-size;
                active: true;
                at-end: root.at-end;
                ms-per-px: root.ms-per-px;
                travel-cap: root.travel-cap;
            }
        }
    }
}

// Game artwork can be corrected for a physical display whose framebuffer
// pixels are not square. A factor of one retains the original contain path;
// other factors alter only the fitted width, without cropping the source.
component ArtworkImage inherits Rectangle {
    in property <image> source;
    in property <bool> has-source;
    in property <float> horizontal-scale: 1.0;

    clip: true;
    property <float> source-aspect: source.height > 0
        ? (source.width / source.height) * horizontal-scale
        : 1.0;
    property <float> box-aspect: root.height > 0px ? root.width / root.height : 1.0;

    if root.horizontal-scale == 1.0: Image {
        source: root.source;
        visible: root.has-source;
        image-fit: contain;
        width: parent.width;
        height: parent.height;
    }

    if root.horizontal-scale != 1.0: Image {
        source: root.source;
        visible: root.has-source;
        image-fit: fill;
        width: root.source-aspect >= root.box-aspect
            ? parent.width
            : parent.height * root.source-aspect;
        height: root.source-aspect >= root.box-aspect
            ? parent.width / root.source-aspect
            : parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// One read-only sheet, using the selected row's already loaded information.
// The application owns navigation; layout supplies the real scroll limit.
component InformationSheet inherits Rectangle {
    in property <string> text;
    in property <float> offset;
    in property <length> font-size;
    in property <length> pad;
    in property <color> text-color;
    in property <color> track-color;
    in property <color> position-color;
    in property <image> art;
    in property <bool> has-art;
    in property <float> art-scale-x: 1.0;
    out property <float> max-scroll: max(0, (content.height - root.height) / 1px);
    property <float> scroll: min(max(0, root.offset), root.max-scroll);
    clip: true;

    content := Rectangle {
        x: root.pad;
        y: -root.scroll * 1px;
        width: max(1px, root.width - root.pad * 3);
        height: information.y + information.preferred-height + root.pad;

        picture := ArtworkImage {
            source: root.art;
            has-source: root.has-art;
            horizontal-scale: root.art-scale-x;
            x: 0px;
            y: root.pad;
            width: parent.width;
            height: root.has-art ? root.font-size * 7 : 0px;
        }

        information := Text {
            text: root.text;
            color: root.text-color;
            font-size: root.font-size;
            x: 0px;
            y: root.has-art ? picture.y + picture.height + root.pad : root.pad;
            width: parent.width;
            height: self.preferred-height;
            wrap: word-wrap;
        }
    }

    if root.max-scroll > 0: Rectangle {
        x: parent.width - root.pad / 2 - 2px;
        y: root.pad;
        width: 2px;
        height: max(1px, parent.height - root.pad * 2);
        background: root.track-color;
        Rectangle {
            width: parent.width;
            height: min(parent.height, max(root.pad, parent.height * root.height / content.height));
            y: (parent.height - self.height) * root.scroll / root.max-scroll;
            background: root.position-color;
        }
    }
}

struct Row {
    title: string,
    favorite: bool,
    cover: image,
    has-cover: bool,
    art-scale-x: float,
    // Options rows carry their current value here; browse rows leave it empty.
    value: string,
}

export { Row }

// Browsing and settings share one title edge and a stable value column.
component MenuRow inherits Rectangle {
    in property <Row> item;
    in property <bool> selected;
    in property <bool> reserve-marker;
    in property <bool> at-end;
    in property <length> pad;
    in property <length> font-size;
    in property <length> value-font;
    in property <length> value-min-width: 0px;
    in property <color> text-color;
    in property <color> value-color;
    in property <color> selection-color;
    in property <color> selection-text;
    in property <color> favorite-color;
    property <length> marker-width: root.reserve-marker || root.item.favorite
        ? root.font-size + root.pad / 2 : 0px;
    property <length> value-width: root.item.value == "" ? 0px
        : min(root.width * 45%, max(root.value-min-width, value-gauge.preferred-width));
    background: root.selected ? root.selection-color : transparent;
    clip: true;

    value-gauge := Text {
        text: root.item.value;
        font-size: root.value-font;
        visible: false;
    }
    Text {
        text: root.item.favorite ? "\u{2665}" : "";
        color: root.favorite-color;
        font-size: root.font-size;
        x: root.pad;
        width: root.marker-width;
        height: parent.height;
        vertical-alignment: center;
    }
    ScrollingTitle {
        text: root.item.title;
        text-color: root.selected ? root.selection-text : root.text-color;
        font-size: root.font-size;
        active: root.selected;
        at-end: root.at-end;
        x: root.pad + root.marker-width;
        width: max(1px, parent.width - root.pad * 2 - root.marker-width
            - root.value-width - (root.value-width > 0px ? root.pad : 0px));
        height: parent.height;
    }
    ScrollingTitle {
        text: root.item.value;
        text-color: root.selected ? root.selection-text : root.value-color;
        font-size: root.value-font;
        active: root.selected;
        at-end: root.at-end;
        align: right;
        x: parent.width - root.pad - root.value-width;
        width: root.value-width;
        height: parent.height;
    }
}

export component DegaussWindow inherits Window {
    // Palette.
    in property <color> c-background;
    in property <color> c-panel;
    in property <color> c-bar;
    in property <color> c-surface;
    in property <color> c-text;
    in property <color> c-text-dim;
    in property <color> c-accent;
    in property <color> c-accent-text;
    in property <color> c-state;
    in property <color> c-favorite;
    // The colour mixed over the original wordmark; transparent leaves its
    // original three colours alone.
    in property <color> logo-tint: transparent;
    in property <bool> logo-tint-enabled: false;
    // Zero is the original artwork and one is the flat logo-tint colour.
    in property <float> logo-tint-mix: 1.0;

    // Safe area, so nothing lands under the bezel.
    in property <length> inset-left;
    in property <length> inset-right;
    in property <length> inset-top;
    in property <length> inset-bottom;

    // Geometry, computed from the framebuffer size.
    in property <length> row-height: 20px;
    // Context-menu groups stay visually distinct without spending a full
    // text row on an intentionally empty separator.
    in property <bool> compact-separators;
    in property <length> body-font: 13px;
    in property <length> small-font: 11px;
    in property <length> pad: 6px;
    in property <length> chrome-height: 22px;

    // The typeface, and the size to set each kind of text at.
    //
    // Two properties for what looks like one thing, because the sizes above
    // are also measurements: rows are spaced by them and the bar's icons are
    // built out of them. Glyphs exist only at the sizes they were baked at,
    // so what is drawn has to be one of those, while what the layout is
    // measured in stays exactly what it was. Rust decides both.
    in property <string> font-family;
    in property <length> body-glyph: 13px;
    in property <length> small-glyph: 11px;
    in property <length> bar-glyph: 9px;
    /// The name of a system standing in for a logo it does not have.
    in property <length> caption-glyph: 22px;
    /// The heart standing in for a picture, in the favourites folder.
    in property <length> heart-glyph: 78px;

    // 0 = browse, 1 = a plain list (menu, context, options, advanced, help,
    // favourite folders), 2 = the wordmark (about and splash), 3 = the
    // screensaver, 4 = the grid of letters, 5 = the theme editor,
    // 6 = the complete, scrollable game information.
    in property <int> screen: 0;
    in property <string> about-version;
    in property <string> about-line;
    in property <string> about-copyright;
    in property <string> about-licence;
    // Within browse: 0 = details, 1 = tiled, 2 = list, 3 = carousel,
    // 4 = multi list, 5 = gallery.
    in property <int> layout: 0;

    in property <[Row]> rows;
    in property <int> selected;
    /// Flipped by a timer so the selected title walks to its end and back.
    in property <bool> marquee-end;
    /// The same for the lines under the picture, which travel at half the
    /// pace and so turn round on their own, slower clock.
    in property <bool> detail-end;
    in property <string> gallery-title;
    in property <bool> gallery-title-visible;

    // The large artwork: a screenshot, a system logo, or nothing.
    in property <image> art;
    in property <bool> has-art;
    in property <float> art-scale-x: 1.0;
    in property <length> art-width;
    // Drawn in the artwork panel when there is no picture for this row and
    // no logo in the logos folder: the system or game name, set large.
    in property <string> art-caption;
    in property <string> group-title;
    in property <string> group-subtitle;
    /// Inside the favourites folder there is nothing to picture and the
    /// name says only what the row already says, so the mark itself stands
    /// in: one big heart in the colour it has everywhere else.
    in property <bool> art-heart;

    in property <int> columns: 3;
    in property <length> tile-width: 100px;
    in property <length> tile-height: 80px;

    in property <string> heading;
    in property <string> heading-detail;
    in property <string> status;
    in property <bool> browse-playable;
    in property <string> plain-scope;
    /// Reserved by the application only on pages with selected-row help.
    in property <float> plain-help-height: 0;
    in property <string> information-text;
    in property <float> information-offset: 0;
    out property <float> information-max-scroll: information-view.max-scroll;
    in property <length> bar-height: 16px;
    in property <length> bar-font: 9px;
    in property <string> clock;
    in property <bool> wifi;
    in property <bool> bluetooth;
    /// Shown for a moment after it changes, then gone again.
    in property <string> speed-badge;
    in property <bool> speed-visible;
    /// The word after the arrows in the wide legend: what left and right
    /// do while browsing. Only the word comes from Rust; the arrows must
    /// stay written in this file or their glyphs are never embedded.
    in property <string> lr-word: "Speed";
    in property <bool> wide-bar;
    in property <bool> show-bar;
    /// Master-category images use a list beside the highlighted local image.
    in property <bool> category-image-picker;
    /// One-game ScreenScraper candidates use a list beside the selected
    /// candidate's artwork instead of a full-width plain list.
    in property <bool> scraper-match-picker;
    /// True on the master list, which is short enough to look stranded
    /// against the top of the screen.
    in property <bool> center-rows;
    /// How many rows the grid of letters is laid out in.
    in property <int> grid-rows: 4;
    /// What the gamelist knows about the selected game, a line each and
    /// already labelled. Always six, so the lines stay in the same places
    /// whatever a card happens to know.
    in property <[DetailLine]> detail-lines;
    /// How tall the block of lines is, and one line of it.
    in property <length> detail-height;
    in property <string> compact-summary;
    in property <string> compact-publisher;
    in property <int> operation-kind: 0;
    in property <bool> operation-details: false;
    in property <string> operation-title;
    in property <string> operation-state;
    in property <string> operation-subject;
    in property <string> operation-activity;
    in property <bool> operation-determinate: false;
    in property <float> operation-fraction: 0;
    in property <string> operation-progress;
    in property <string> operation-percent;
    in property <string> operation-note;
    in property <[DetailLine]> operation-counts;
    in property <string> operation-problem;
    in property <string> operation-controls;
    in property <length> detail-line;
    /// True on the list of groups, which is short and leaves the bottom of
    /// its column empty.
    in property <bool> show-brand;
    /// True when the grid is narrowing a list rather than jumping down it,
    /// which is the only time the two spare buttons edit anything.
    in property <bool> find-search;
    in property <bool> find-filtering;
    in property <string> find-query;
    // Theme editor sub-screen: 0 roles, 1 hex, 2 swap, 3 name, 4 discard,
    // 5 continuous RGB picker.
    in property <int> theme-editor-mode: 0;
    in property <int> theme-selected-role: -1;
    in property <[string]> theme-hex-digits;
    in property <int> theme-hex-cursor: 0;
    in property <color> theme-edit-color;
    in property <string> theme-edit-hex;
    in property <int> theme-picker-channel: 0;
    in property <string> theme-name;
    in property <int> theme-name-save-index: -1;
    in property <int> theme-name-cancel-index: -1;
    /// Screen-specific controls for a grid. Empty keeps the established
    /// jump/search legend above.
    in property <string> grid-help;
    /// Screen-specific controls for a plain list. Empty keeps the established
    /// menu/settings legend below.
    in property <string> plain-help;
    in property <length> saver-cell;
    in property <length> saver-offset;
    in property <string> overlay;
    in property <bool> overlay-dismissible;
    in property <float> overlay-offset;
    out property <float> overlay-max-scroll: message-panel.max-scroll;
    out property <bool> bottom-bar-visible: root.show-bar && (root.operation-kind == 0 || root.operation-details) && !message-panel.visible;
    out property <bool> operation-footer-visible: root.operation-kind != 0 && !root.operation-details && !message-panel.visible;
    in property <bool> index-active;
    in property <float> index-fraction;
    // The performance readout, shown only when asked for.
    in property <string> stats;
    in property <bool> show-stats;

    property <bool> has-heading: root.screen == 1 || root.screen == 4
        || root.screen == 5 || root.screen == 6
        || (root.screen == 0 && root.layout != 5);
    property <length> heading-height: root.has-heading ? root.chrome-height : 0px;
    property <length> help-height: root.screen == 1
        ? max(0, root.plain-help-height) * 1px : 0px;

    default-font-family: root.font-family;

    // Never drawn. It exists so that the characters it names are ones the
    // compiler has seen written down, which is the only thing that makes
    // their glyphs part of the binary.
    Charset { }
    background: root.screen == 3 ? #000000 : root.c-background;

    // Everything lives inside the safe rectangle.
    Rectangle {
        x: root.inset-left;
        y: root.inset-top;
        width: root.width - root.inset-left - root.inset-right;
        height: root.height - root.inset-top - root.inset-bottom;
        clip: true;

        // ---- title bar ---------------------------------------------------
        // Location and position stay separate from the selected row.
        if root.has-heading: heading-bar := Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: root.chrome-height;
            property <string> right-text: root.heading-detail != ""
                ? root.heading-detail
                : root.help-height > 0px ? root.plain-scope
                : root.screen == 6 || root.screen == 0 ? "" : root.status;
            property <length> right-width: self.right-text == "" ? 0px
                : min(self.width * 55%, heading-detail-gauge.preferred-width);
            property <length> brand-width: root.screen == 0 && root.show-brand
                ? self.width * 28% : 0px;
            Rectangle {
                visible: !root.show-brand;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.c-panel;
            }
            heading-detail-gauge := Text {
                text: heading-bar.right-text;
                font-size: root.small-glyph;
                visible: false;
            }
            BlendedLogo {
                visible: heading-bar.brand-width > 0px;
                x: root.pad;
                y: 0px;
                width: heading-bar.brand-width;
                height: parent.height;
                tint: root.logo-tint;
                tint-mix: root.logo-tint-mix;
                tint-enabled: root.logo-tint-enabled;
            }
            ScrollingTitle {
                text: root.heading;
                text-color: root.c-text;
                font-size: root.small-glyph;
                active: true;
                at-end: root.marquee-end;
                x: root.pad + heading-bar.brand-width
                    + (heading-bar.brand-width > 0px ? root.pad : 0px);
                width: max(1px, parent.width - self.x - root.pad
                    - heading-bar.right-width - (heading-bar.right-width > 0px ? root.pad * 2 : 0px));
                height: parent.height;
            }
            ScrollingTitle {
                text: heading-bar.right-text;
                text-color: root.help-height > 0px || root.heading-detail != ""
                    ? root.c-text-dim : root.c-state;
                font-size: root.small-glyph;
                align: right;
                active: true;
                at-end: root.marquee-end;
                x: parent.width - root.pad - heading-bar.right-width;
                width: heading-bar.right-width;
                height: parent.height;
            }
        }

        // ---- body --------------------------------------------------------
        Rectangle {
            x: 0;
            y: root.heading-height;
            width: parent.width;
            height: root.screen == 3
                ? parent.height
                : parent.height
                    - root.heading-height - root.help-height
                    - (root.show-bar ? root.bar-height : 0px);
            clip: true;

            information-view := InformationSheet {
                visible: root.screen == 6;
                width: parent.width;
                height: parent.height;
                text: root.information-text;
                offset: root.information-offset;
                font-size: root.small-glyph;
                pad: root.pad;
                text-color: root.c-text;
                track-color: root.c-panel;
                position-color: root.c-state;
                art: root.art;
                has-art: root.screen == 6 && root.has-art;
                art-scale-x: root.art-scale-x;
            }

            // The wordmark, on its own. Used for the splash and About.
            //
            // Positioned by hand rather than by a layout: percentages of a
            // layout's parent resolve to nothing here, and the result is a
            // blank screen.
            if root.screen == 2: Rectangle {
                width: parent.width;
                height: parent.height;
                background: root.c-background;

                logo := BlendedLogo {
                    tint: root.logo-tint;
                    tint-mix: root.logo-tint-mix;
                    tint-enabled: root.logo-tint-enabled;
                    width: parent.width * 70%;
                    height: parent.height * 38%;
                    x: (parent.width - self.width) / 2;
                    y: parent.height * 18%;
                }

                Text {
                    text: root.about-version;
                    color: root.c-text-dim;
                    font-size: root.small-glyph;
                    horizontal-alignment: center;
                    width: parent.width;
                    y: logo.y + logo.height + root.pad;
                }

                Text {
                    text: root.overlay != "" ? root.overlay : root.about-line;
                    color: root.overlay != "" ? root.c-text : root.c-text-dim;
                    font-size: root.small-glyph;
                    horizontal-alignment: center;
                    width: parent.width;
                    y: logo.y + logo.height + root.pad * 2 + root.small-font;
                }

                Text {
                    text: root.about-copyright;
                    color: root.c-text-dim;
                    font-size: root.small-glyph;
                    horizontal-alignment: center;
                    width: parent.width;
                    y: logo.y + logo.height + root.pad * 3 + root.small-font * 2;
                }

                Text {
                    text: root.about-licence;
                    color: root.c-text-dim;
                    font-size: root.small-glyph;
                    horizontal-alignment: center;
                    width: parent.width;
                    y: logo.y + logo.height + root.pad * 4 + root.small-font * 3;
                }
            }

            // A plain list: menus, options, help, and the browse "list" layout.
            if (root.screen == 1
                && !root.category-image-picker
                && !root.scraper-match-picker)
                || (root.screen == 0 && root.layout == 2): VerticalLayout {
                alignment: root.center-rows ? LayoutAlignment.center : LayoutAlignment.start;
                spacing: 0px;
                for row[index] in root.rows: MenuRow {
                    height: root.compact-separators && row.title == ""
                        ? root.row-height / 2
                        : root.row-height;
                    item: row;
                    selected: index == root.selected;
                    reserve-marker: root.screen == 0;
                    at-end: root.marquee-end;
                    pad: root.pad;
                    font-size: root.body-glyph;
                    value-font: root.body-glyph;
                    text-color: root.c-text;
                    value-color: root.c-text-dim;
                    selection-color: root.c-accent;
                    selection-text: root.c-accent-text;
                    favorite-color: root.c-favorite;
                }
            }

            // Browse, multi list: two text columns in reading order.
            if root.screen == 0 && root.layout == 4: Rectangle {
                background: root.c-background;
                for row[index] in root.rows: MenuRow {
                    property <length> column-gap: root.pad / 2;
                    property <length> cell-width: (parent.width - self.column-gap) / 2;
                    x: mod(index, 2) * (self.cell-width + self.column-gap);
                    y: floor(index / 2) * root.row-height;
                    width: self.cell-width;
                    height: root.row-height;
                    item: row;
                    selected: index == root.selected;
                    reserve-marker: true;
                    at-end: root.marquee-end;
                    pad: root.pad;
                    font-size: root.body-glyph;
                    value-font: root.small-glyph;
                    value-min-width: 28px;
                    text-color: root.c-text;
                    value-color: root.c-text-dim;
                    selection-color: root.c-accent;
                    selection-text: root.c-accent-text;
                    favorite-color: root.c-favorite;
                }
            }

            // Category-image chooser: keep the normal full-height menu rows
            // on the left and show the highlighted file on the right. The
            // preview is the selection itself, so it changes while moving
            // through the list rather than only after A installs the file.
            if root.screen == 1 && root.category-image-picker: HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: parent.width * 56%;
                    background: root.c-background;
                    clip: true;
                    VerticalLayout {
                        alignment: LayoutAlignment.start;
                        spacing: 0px;
                        for row[index] in root.rows: Rectangle {
                            height: root.row-height;
                            background: index == root.selected ? root.c-accent : transparent;
                            ScrollingTitle {
                                x: root.pad;
                                width: parent.width - root.pad * 2;
                                height: parent.height;
                                text: row.title;
                                text-color: index == root.selected
                                    ? root.c-accent-text
                                    : root.c-text;
                                font-size: root.body-glyph;
                                active: index == root.selected;
                                at-end: root.marquee-end;
                            }
                        }
                    }
                }

                Rectangle {
                    background: root.c-surface;
                    ArtworkImage {
                        source: root.art;
                        has-source: root.has-art;
                        horizontal-scale: 1.0;
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                    }
                    Text {
                        visible: !root.has-art;
                        text: root.art-caption;
                        color: root.c-text-dim;
                        font-size: root.small-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        x: root.pad;
                        y: root.pad;
                        width: parent.width - root.pad * 2;
                        height: parent.height - root.pad * 2;
                    }
                }
            }

            // Manual matching is intentionally a one-game screen. Candidate
            // names remain scrollable on the left; the highlighted result's
            // screenshot is previewed on the right before it can be applied.
            if root.screen == 1 && root.scraper-match-picker: HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: parent.width * 58%;
                    background: root.c-background;
                    clip: true;
                    VerticalLayout {
                        alignment: LayoutAlignment.start;
                        spacing: 0px;
                        for row[index] in root.rows: Rectangle {
                            height: root.row-height;
                            background: index == root.selected ? root.c-accent : transparent;
                            HorizontalLayout {
                                padding-left: root.pad;
                                padding-right: root.pad;
                                spacing: root.pad / 2;
                                ScrollingTitle {
                                    text: row.title;
                                    text-color: index == root.selected
                                        ? root.c-accent-text
                                        : root.c-text;
                                    font-size: root.body-glyph;
                                    active: index == root.selected;
                                    at-end: root.marquee-end;
                                }
                                Text {
                                    text: row.value;
                                    color: index == root.selected
                                        ? root.c-accent-text
                                        : root.c-text-dim;
                                    font-size: root.small-glyph;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: row.value == "" ? 0px : self.preferred-width;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: root.c-surface;
                    ArtworkImage {
                        source: root.art;
                        has-source: root.has-art;
                        horizontal-scale: 1.0;
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                    }
                    Text {
                        visible: !root.has-art;
                        text: root.art-caption;
                        color: root.c-text-dim;
                        font-size: root.small-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        x: root.pad;
                        y: root.pad;
                        width: parent.width - root.pad * 2;
                        height: parent.height - root.pad * 2;
                    }
                }
            }

            // A grid of letters: jump down a long list, or narrow it.
            if root.screen == 4: find-body := Rectangle {
                width: parent.width;
                height: parent.height;
                property <length> query-height: root.find-filtering
                    ? root.chrome-height + root.pad * 2 : 0px;
                property <length> explanation-height: root.find-filtering
                    ? root.small-glyph * 1.5 + root.pad * 2 : 0px;
                if root.find-filtering: Rectangle {
                    x: root.pad;
                    y: root.pad;
                    width: parent.width - root.pad * 2;
                    height: find-body.query-height - root.pad;
                    background: root.c-panel;
                    ScrollingTitle {
                        text: root.find-query + "_";
                        text-color: root.c-text;
                        font-size: root.body-glyph;
                        active: true;
                        at-end: root.marquee-end;
                        x: root.pad;
                        width: parent.width - root.pad * 2;
                        height: parent.height;
                    }
                }
                Rectangle {
                    y: find-body.query-height;
                    width: parent.width;
                    height: parent.height - find-body.query-height - find-body.explanation-height;
                    for cell[index] in root.rows: Rectangle {
                        property <length> cell-width: parent.width / root.columns;
                        property <length> cell-height: parent.height / root.grid-rows;
                        width: self.cell-width;
                        height: self.cell-height;
                        x: Math.mod(index, root.columns) * self.cell-width;
                        y: Math.floor(index / root.columns) * self.cell-height;
                        background: index == root.selected ? root.c-accent : transparent;
                        Text {
                            text: cell.title;
                            color: index == root.selected ? root.c-accent-text : root.c-text;
                            font-size: root.body-glyph;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
                if root.find-filtering: Text {
                    text: "Live Filter · B Keeps the Search";
                    color: root.c-text-dim;
                    font-size: root.small-glyph;
                    x: root.pad;
                    y: parent.height - find-body.explanation-height;
                    width: parent.width - root.pad * 2;
                    height: find-body.explanation-height;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Theme editor: controls on the left, the effective palette on
            // the right. The preview uses the same root colour properties
            // as every other screen, so each change is the real rendering.
            if root.screen == 5: theme-screen := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                editor-side := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: theme-screen.width * 55%;
                    height: theme-screen.height;
                    background: root.c-panel;
                    clip: true;

                    if root.theme-editor-mode != 1
                        && root.theme-editor-mode != 3
                        && root.theme-editor-mode != 5: VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: editor-side.width;
                        height: editor-side.height;
                        spacing: 0px;
                        cross-axis-alignment: stretch;
                        for row[index] in root.rows: Rectangle {
                            min-width: editor-side.width;
                            max-width: editor-side.width;
                            horizontal-stretch: 1;
                            height: root.row-height;
                            background: index == root.selected ? root.c-accent : transparent;
                            ScrollingTitle {
                                x: root.pad;
                                width: editor-side.width * 56% - root.pad;
                                height: parent.height;
                                text: row.title;
                                text-color: index == root.selected ? root.c-accent-text : root.c-text;
                                font-size: root.body-glyph;
                                active: index == root.selected;
                                at-end: root.marquee-end;
                            }
                            Text {
                                x: editor-side.width * 56%;
                                y: 0px;
                                width: editor-side.width * 44% - root.pad;
                                height: parent.height;
                                text: row.value;
                                color: index == root.selected ? root.c-accent-text : root.c-text-dim;
                                font-size: root.body-glyph;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    if root.theme-editor-mode == 1: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: editor-side.width;
                        height: editor-side.height;

                        hex-entry := Rectangle {
                            property <length> cell-width: min(root.body-glyph * 1.7,
                                editor-side.width / 8);
                            width: self.cell-width * 6;
                            height: root.row-height * 2;
                            x: (parent.width - self.width) / 2;
                            y: parent.height * 24%;

                            for digit[index] in root.theme-hex-digits: Rectangle {
                                x: index * hex-entry.cell-width;
                                width: hex-entry.cell-width;
                                height: parent.height;
                                Text {
                                    text: digit;
                                    color: root.c-text;
                                    font-size: root.body-glyph * 2;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    visible: index == root.theme-hex-cursor;
                                    x: 1px;
                                    y: parent.height - 3px;
                                    width: parent.width - 2px;
                                    height: 3px;
                                    background: root.c-accent;
                                }
                            }
                        }
                        Text {
                            text: "# Hex colour";
                            color: root.c-text-dim;
                            font-size: root.body-glyph;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: root.row-height;
                            y: hex-entry.y + hex-entry.height + root.pad;
                        }
                        Text {
                            text: "R   R   G   G   B   B";
                            color: root.c-text-dim;
                            font-size: root.small-glyph;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: root.row-height;
                            y: hex-entry.y + hex-entry.height + root.pad + root.row-height;
                        }
                    }

                    if root.theme-editor-mode == 5: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: editor-side.width;
                        height: editor-side.height;

                        Rectangle {
                            x: parent.width * 20%;
                            y: parent.height * 6%;
                            width: parent.width * 20%;
                            height: parent.height * 16%;
                            background: root.theme-edit-color;
                            border-width: 2px;
                            border-color: root.c-text;
                        }
                        Text {
                            x: parent.width * 44%;
                            y: parent.height * 6%;
                            width: parent.width * 42%;
                            height: parent.height * 16%;
                            text: root.theme-edit-hex;
                            color: root.c-text;
                            font-size: root.body-glyph;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }

                        red-picker := Rectangle {
                            x: root.pad;
                            y: parent.height * 30%;
                            width: parent.width - root.pad * 2;
                            height: parent.height * 16%;
                            border-width: root.theme-picker-channel == 0 ? 2px : 1px;
                            border-color: root.theme-picker-channel == 0 ? root.c-accent : root.c-text-dim;
                            Text {
                                x: root.pad;
                                width: parent.width * 12%;
                                height: parent.height;
                                text: "R";
                                color: root.c-text;
                                font-size: root.body-glyph;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            red-bar := Rectangle {
                                x: parent.width * 16%;
                                y: parent.height * 22%;
                                width: parent.width * 80%;
                                height: parent.height * 56%;
                                background: @linear-gradient(90deg,
                                    rgb(0, root.theme-edit-color.green, root.theme-edit-color.blue) 0%,
                                    rgb(255, root.theme-edit-color.green, root.theme-edit-color.blue) 100%);
                                Rectangle {
                                    x: (red-bar.width - 3px) * root.theme-edit-color.red / 255;
                                    y: -2px;
                                    width: 3px;
                                    height: parent.height + 4px;
                                    background: root.c-text;
                                    border-width: 1px;
                                    border-color: root.c-background;
                                }
                            }
                        }

                        green-picker := Rectangle {
                            x: root.pad;
                            y: parent.height * 50%;
                            width: parent.width - root.pad * 2;
                            height: parent.height * 16%;
                            border-width: root.theme-picker-channel == 1 ? 2px : 1px;
                            border-color: root.theme-picker-channel == 1 ? root.c-accent : root.c-text-dim;
                            Text {
                                x: root.pad;
                                width: parent.width * 12%;
                                height: parent.height;
                                text: "G";
                                color: root.c-text;
                                font-size: root.body-glyph;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            green-bar := Rectangle {
                                x: parent.width * 16%;
                                y: parent.height * 22%;
                                width: parent.width * 80%;
                                height: parent.height * 56%;
                                background: @linear-gradient(90deg,
                                    rgb(root.theme-edit-color.red, 0, root.theme-edit-color.blue) 0%,
                                    rgb(root.theme-edit-color.red, 255, root.theme-edit-color.blue) 100%);
                                Rectangle {
                                    x: (green-bar.width - 3px) * root.theme-edit-color.green / 255;
                                    y: -2px;
                                    width: 3px;
                                    height: parent.height + 4px;
                                    background: root.c-text;
                                    border-width: 1px;
                                    border-color: root.c-background;
                                }
                            }
                        }

                        blue-picker := Rectangle {
                            x: root.pad;
                            y: parent.height * 70%;
                            width: parent.width - root.pad * 2;
                            height: parent.height * 16%;
                            border-width: root.theme-picker-channel == 2 ? 2px : 1px;
                            border-color: root.theme-picker-channel == 2 ? root.c-accent : root.c-text-dim;
                            Text {
                                x: root.pad;
                                width: parent.width * 12%;
                                height: parent.height;
                                text: "B";
                                color: root.c-text;
                                font-size: root.body-glyph;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            blue-bar := Rectangle {
                                x: parent.width * 16%;
                                y: parent.height * 22%;
                                width: parent.width * 80%;
                                height: parent.height * 56%;
                                background: @linear-gradient(90deg,
                                    rgb(root.theme-edit-color.red, root.theme-edit-color.green, 0) 0%,
                                    rgb(root.theme-edit-color.red, root.theme-edit-color.green, 255) 100%);
                                Rectangle {
                                    x: (blue-bar.width - 3px) * root.theme-edit-color.blue / 255;
                                    y: -2px;
                                    width: 3px;
                                    height: parent.height + 4px;
                                    background: root.c-text;
                                    border-width: 1px;
                                    border-color: root.c-background;
                                }
                            }
                        }
                    }

                    if root.theme-editor-mode == 3: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: editor-side.width;
                        height: editor-side.height;

                        Rectangle {
                            x: root.pad;
                            y: root.pad;
                            width: parent.width - root.pad * 2;
                            height: root.row-height * 2;
                            background: root.c-surface;
                            border-width: 1px;
                            border-color: root.c-accent;
                            Text {
                                text: root.theme-name == "" ? "Theme name" : root.theme-name;
                                color: root.theme-name == "" ? root.c-text-dim : root.c-text;
                                font-size: root.body-glyph;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: root.row-height * 2 + root.pad * 2;
                            width: parent.width;
                            height: parent.height - self.y;
                            for cell[index] in root.rows: Rectangle {
                                property <length> cell-width: parent.width / root.columns;
                                property <length> cell-height: parent.height / root.grid-rows;
                                width: self.cell-width;
                                height: self.cell-height;
                                x: Math.mod(index, root.columns) * self.cell-width;
                                y: Math.floor(index / root.columns) * self.cell-height;
                                background: index == root.selected ? root.c-accent : transparent;
                                if index != root.theme-name-save-index
                                    && index != root.theme-name-cancel-index: Text {
                                    text: cell.title;
                                    color: index == root.selected ? root.c-accent-text : root.c-text;
                                    font-size: root.small-glyph;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if index == root.theme-name-save-index: Rectangle {
                                    property <length> dot: max(2px, root.small-glyph * 0.16);
                                    width: self.dot * 7;
                                    height: self.dot * 5;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    for point in [
                                        {x: 0, y: 2}, {x: 1, y: 3}, {x: 2, y: 4},
                                        {x: 3, y: 3}, {x: 4, y: 2}, {x: 5, y: 1},
                                        {x: 6, y: 0},
                                    ]: Rectangle {
                                        x: point.x * parent.dot;
                                        y: point.y * parent.dot;
                                        width: parent.dot;
                                        height: parent.dot;
                                        background: #33ff66;
                                    }
                                }
                                if index == root.theme-name-cancel-index: Text {
                                    text: "X";
                                    color: #ff3232;
                                    font-size: root.small-glyph;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                preview := Rectangle {
                    x: theme-screen.width * 56%;
                    y: 0px;
                    width: theme-screen.width * 44%;
                    height: theme-screen.height;
                    background: root.c-background;
                    border-width: root.theme-selected-role == 0 ? 2px : 0px;
                    border-color: root.c-accent;

                    panel-sample := Rectangle {
                        x: root.pad;
                        y: root.pad;
                        width: parent.width - root.pad * 2;
                        height: parent.height * 23%;
                        background: root.c-panel;
                        border-width: root.theme-selected-role == 1 ? 2px : 0px;
                        border-color: root.c-accent;
                        BlendedLogo {
                            tint: root.logo-tint;
                            tint-mix: root.logo-tint-mix;
                            tint-enabled: root.logo-tint-enabled;
                            x: root.pad;
                            y: root.pad;
                            width: parent.width - root.pad * 2;
                            height: parent.height - root.pad * 2;
                        }
                    }

                    surface-sample := Rectangle {
                        x: root.pad;
                        y: parent.height * 27%;
                        width: parent.width - root.pad * 2;
                        height: parent.height * 40%;
                        background: root.c-surface;
                        border-width: root.theme-selected-role == 2 ? 2px : 0px;
                        border-color: root.c-accent;

                        text-sample := Rectangle {
                            x: root.pad;
                            y: root.pad;
                            width: parent.width - root.pad * 2;
                            height: root.row-height;
                            border-width: root.theme-selected-role == 4 ? 2px : 0px;
                            border-color: root.c-accent;
                            Text {
                                text: "Ordinary text";
                                color: root.c-text;
                                font-size: root.small-glyph;
                                vertical-alignment: center;
                                x: root.pad / 2;
                            }
                        }
                        dim-sample := Rectangle {
                            x: root.pad;
                            y: root.pad + root.row-height;
                            width: parent.width - root.pad * 2;
                            height: root.row-height;
                            border-width: root.theme-selected-role == 5 ? 2px : 0px;
                            border-color: root.c-accent;
                            Text {
                                text: "Dim text";
                                color: root.c-text-dim;
                                font-size: root.small-glyph;
                                vertical-alignment: center;
                                x: root.pad / 2;
                            }
                        }
                        selection-sample := Rectangle {
                            x: root.pad;
                            y: root.pad + root.row-height * 2;
                            width: parent.width - root.pad * 2;
                            height: root.row-height;
                            background: root.c-accent;
                            border-width: root.theme-selected-role == 6 ? 2px : 0px;
                            border-color: root.c-text;
                            Rectangle {
                                x: root.pad / 2;
                                width: parent.width - root.pad;
                                height: parent.height;
                                border-width: root.theme-selected-role == 7 ? 2px : 0px;
                                border-color: root.c-state;
                                Text {
                                    text: "Selected text";
                                    color: root.c-accent-text;
                                    font-size: root.small-glyph;
                                    vertical-alignment: center;
                                    x: root.pad / 2;
                                }
                            }
                        }
                        state-sample := Rectangle {
                            x: root.pad;
                            y: root.pad + root.row-height * 3;
                            width: (parent.width - root.pad * 3) / 2;
                            height: root.row-height;
                            border-width: root.theme-selected-role == 8 ? 2px : 0px;
                            border-color: root.c-accent;
                            Text {
                                text: "On";
                                color: root.c-state;
                                font-size: root.small-glyph;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        favourite-sample := Rectangle {
                            x: parent.width / 2;
                            y: root.pad + root.row-height * 3;
                            width: (parent.width - root.pad * 3) / 2;
                            height: root.row-height;
                            border-width: root.theme-selected-role == 9 ? 2px : 0px;
                            border-color: root.c-accent;
                            Text {
                                text: "\u{2665} Favourite";
                                color: root.c-favorite;
                                font-size: root.small-glyph;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        x: root.pad;
                        y: parent.height * 70%;
                        width: parent.width - root.pad * 2;
                        height: parent.height * 28%;
                        background: root.c-bar;
                        border-width: root.theme-selected-role == 3 ? 2px : 0px;
                        border-color: root.c-accent;
                        Text {
                            text: "Bottom bar";
                            color: root.c-text-dim;
                            font-size: root.small-glyph;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Browse, preview: titles on the left, a big picture on the right.
            if root.screen == 0 && root.layout == 0: HorizontalLayout {
                spacing: root.pad / 2;

                Rectangle {
                    background: root.c-background;
                    clip: true;

                    VerticalLayout {
                        alignment: root.center-rows ? LayoutAlignment.center : LayoutAlignment.start;
                        spacing: 0px;
                        for row[index] in root.rows: MenuRow {
                            height: root.row-height;
                            item: row;
                            selected: index == root.selected;
                            reserve-marker: !root.show-brand;
                            at-end: root.marquee-end;
                            pad: root.pad;
                            font-size: root.body-glyph;
                            value-font: root.small-glyph;
                            value-min-width: 34px;
                            text-color: root.c-text;
                            value-color: root.c-text-dim;
                            selection-color: root.c-accent;
                            selection-text: root.c-accent-text;
                            favorite-color: root.c-favorite;
                        }
                    }
                }

                Rectangle {
                    width: root.art-width;
                    background: root.group-title != "" ? root.c-background : root.c-surface;
                    property <length> panel: root.detail-height;
                    property <bool> group: root.group-title != "";

                    ArtworkImage {
                        source: root.art;
                        has-source: root.has-art;
                        horizontal-scale: root.art-scale-x;
                        x: root.pad / 2;
                        y: parent.group ? parent.height * 18% : root.pad / 2;
                        width: parent.width - root.pad;
                        height: parent.group ? parent.height * 42%
                            : parent.height - parent.panel - root.pad;
                    }
                    // The stand-in when there is no picture, and there is
                    // nothing worth picturing.
                    Text {
                        visible: !root.has-art && root.art-heart;
                        text: "\u{2665}";
                        color: root.c-favorite;
                        font-size: root.heart-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        x: root.pad;
                        y: 0px;
                        width: parent.width - root.pad * 2;
                        height: parent.group ? parent.height * 60% : parent.height - parent.panel;
                    }
                    // The stand-in when there is no picture.
                    // Stands in for a logo, so it is set like one rather
                    // than like a caption.
                    Text {
                        visible: !root.has-art && !root.art-heart && !parent.group;
                        text: root.art-caption;
                        color: root.c-text;
                        font-size: root.caption-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        x: root.pad;
                        y: 0px;
                        width: parent.width - root.pad * 2;
                        height: parent.height - parent.panel;
                    }
                    Text {
                        visible: parent.group;
                        text: root.group-title;
                        color: root.c-text;
                        font-size: root.caption-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        x: root.pad;
                        y: parent.height * 63%;
                        width: parent.width - root.pad * 2;
                        height: root.caption-glyph * 1.4;
                        overflow: elide;
                    }
                    Text {
                        visible: parent.group;
                        text: root.group-subtitle;
                        color: root.c-text-dim;
                        font-size: root.small-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        x: root.pad;
                        y: parent.height * 63% + root.caption-glyph * 1.6;
                        width: parent.width - root.pad * 2;
                        height: root.small-glyph * 1.4;
                        overflow: elide;
                    }

                    Rectangle {
                        x: root.pad;
                        y: parent.height - parent.panel;
                        width: parent.width - root.pad * 2;
                        height: parent.panel;
                        visible: parent.panel > 0px;
                        for line[index] in [root.compact-summary, root.compact-publisher, "X Actions for Info"] : Text {
                            text: line;
                            color: root.c-text;
                            font-size: root.small-glyph;
                            y: index * root.detail-line;
                            width: parent.width;
                            height: root.detail-line;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            // Browse, covers: a grid of large tiles, placed by index.
            if root.screen == 0 && root.layout == 1: Rectangle {
                background: root.c-background;
                for row[index] in root.rows: Rectangle {
                    property <length> gap: root.pad / 2;
                    x: mod(index, root.columns) * root.tile-width + self.gap / 2;
                    y: floor(index / root.columns) * root.tile-height + self.gap / 2;
                    width: root.tile-width - self.gap;
                    height: root.tile-height - self.gap;
                    background: index == root.selected ? root.c-accent : root.c-background;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px - root.small-font;
                        background: root.c-surface;
                    }
                    ArtworkImage {
                        source: row.cover;
                        has-source: row.has-cover;
                        horizontal-scale: row.art-scale-x;
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px - root.small-font;
                    }
                    // In the corner of the tile rather than beside a title
                    // there is no room for: the picture is the row here.
                    Text {
                        text: row.favorite ? "\u{2665}" : "";
                        color: root.c-favorite;
                        font-size: root.small-glyph;
                        x: 3px;
                        y: 2px;
                    }
                    ScrollingTitle {
                        text: row.title;
                        text-color: index == root.selected ? root.c-accent-text : root.c-text-dim;
                        font-size: root.small-glyph;
                        align: center;
                        active: index == root.selected;
                        at-end: root.marquee-end;
                        x: 2px;
                        y: parent.height - root.small-font - 2px;
                        width: parent.width - 4px;
                        height: root.small-font;
                    }
                }
            }


            // Browse, carousel: one cover across the middle, its
            // neighbours half off each edge. Nothing moves; a cover that
            // slides into place is a cover you are waiting for.
            //
            // Inside the browse body so the shared footer and modal progress
            // remain above the artwork in every layout.
            if root.screen == 0 && root.layout == 3: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clip: true;
                property <length> panel: root.detail-height;

                for row[index] in root.rows: Rectangle {
                    // Where this one sits relative to the chosen one, so
                    // the middle stays the middle even at the ends of the
                    // list, where the window cannot centre itself.
                    property <int> offset: index - root.selected;

                    x: (parent.width - root.tile-width) / 2 + offset * root.tile-width;
                    y: 0;
                    width: root.tile-width;
                    height: parent.height - parent.panel;

                    ArtworkImage {
                        source: row.cover;
                        has-source: row.has-cover;
                        horizontal-scale: row.art-scale-x;
                        x: root.pad;
                        y: root.pad;
                        width: parent.width - root.pad * 2;
                        height: parent.height - root.pad * 3 - root.body-font;
                    }

                    Text {
                        text: row.has-cover ? "" : row.title;
                        color: root.c-text-dim;
                        font-size: root.small-glyph;
                        x: root.pad;
                        y: root.pad;
                        width: parent.width - root.pad * 2;
                        height: parent.height - root.pad * 3 - root.body-font;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                    }

                    // The ones either side are held back so the middle
                    // reads as the one being chosen.
                    Rectangle {
                        background: #000000;
                        opacity: offset == 0 ? 0.0 : 0.5;
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                    }

                    // In the corner of the cover, not on the title line: the
                    // title scrolls and the heart must not move with it.
                    Text {
                        text: row.favorite ? "\u{2665}" : "";
                        color: root.c-favorite;
                        font-size: root.body-glyph;
                        x: root.pad;
                        y: root.pad;
                    }
                    Rectangle {
                        visible: offset == 0;
                        x: root.pad / 2;
                        y: parent.height - root.body-font - root.pad * 1.5;
                        width: parent.width - root.pad;
                        height: root.body-font + root.pad;
                        background: root.c-panel;
                    }
                    ScrollingTitle {
                        text: row.title;
                        text-color: offset == 0 ? root.c-text : root.c-text-dim;
                        font-size: root.body-glyph;
                        align: center;
                        active: offset == 0;
                        at-end: root.marquee-end;
                        x: root.pad;
                        y: parent.height - root.body-font - root.pad;
                        width: parent.width - root.pad * 2;
                        height: root.body-font;
                    }
                }

                // Once, under the row, for the cover in the middle: six copies
                // of the same lines sliding past each other would be unreadable.
                DetailPanel {
                    x: root.pad;
                    y: parent.height - parent.panel;
                    width: parent.width - root.pad * 2;
                    height: parent.panel;
                    lines: root.detail-lines;
                    font-size: root.small-glyph;
                    line-height: root.detail-line;
                    pad: root.pad;
                    text-color: root.c-text;
                    label-color: root.c-text-dim;
                    at-end: root.detail-end;
                    ms-per-px: 44;
                    travel-cap: 8000ms;
                }
            }

            // Browse, gallery: dense thumbnails, with the selected title
            // shown separately rather than reserving a caption in every cell.
            if root.screen == 0 && root.layout == 5: Rectangle {
                background: root.c-background;
                for row[index] in root.rows: Rectangle {
                    property <length> gap: root.pad / 2;
                    x: mod(index, root.columns) * root.tile-width + self.gap / 2;
                    y: floor(index / root.columns) * root.tile-height + self.gap / 2;
                    width: root.tile-width - self.gap;
                    height: root.tile-height - self.gap;
                    background: root.c-surface;

                    ArtworkImage {
                        source: row.cover;
                        has-source: row.has-cover;
                        horizontal-scale: row.art-scale-x;
                        x: 3px;
                        y: 3px;
                        width: parent.width - 6px;
                        height: parent.height - 6px;
                    }

                    Text {
                        visible: !row.has-cover;
                        text: row.title;
                        color: index == root.selected ? root.c-text : root.c-text-dim;
                        font-size: root.small-glyph;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        x: root.pad / 2;
                        y: root.pad / 2;
                        width: parent.width - root.pad;
                        height: parent.height - root.pad;
                    }

                    Text {
                        text: row.favorite ? "\u{2665}" : "";
                        color: root.c-favorite;
                        font-size: root.small-glyph;
                        x: 4px;
                        y: 3px;
                    }

                    // Four overlay strips preserve the two-pixel selection
                    // outline without changing this cell or any neighbour.
                    Rectangle {
                        visible: index == root.selected;
                        background: root.c-accent;
                        x: 0px; y: 0px;
                        width: parent.width; height: 2px;
                    }
                    Rectangle {
                        visible: index == root.selected;
                        background: root.c-accent;
                        x: 0px; y: parent.height - 2px;
                        width: parent.width; height: 2px;
                    }
                    Rectangle {
                        visible: index == root.selected;
                        background: root.c-accent;
                        x: 0px; y: 0px;
                        width: 2px; height: parent.height;
                    }
                    Rectangle {
                        visible: index == root.selected;
                        background: root.c-accent;
                        x: parent.width - 2px; y: 0px;
                        width: 2px; height: parent.height;
                    }
                }
            }
        }

        // The selected setting's explanation has a stable place of its own.
        if root.help-height > 0px: Rectangle {
            x: 0px;
            y: parent.height - (root.show-bar ? root.bar-height : 0px) - root.help-height;
            width: parent.width;
            height: root.help-height - root.pad / 2;
            background: root.c-panel;
            Text {
                text: root.plain-scope;
                color: root.c-text-dim;
                font-size: root.small-glyph;
                x: root.pad;
                y: root.pad / 2;
                width: parent.width - root.pad * 2;
                height: root.small-glyph * 1.3;
                overflow: elide;
            }
            Rectangle {
                x: root.pad;
                y: root.pad / 2 + root.small-glyph * 1.3;
                width: parent.width - root.pad * 2;
                height: parent.height - root.pad - root.small-glyph * 1.3;
                clip: true;
                Text {
                    text: root.status;
                    color: root.c-text;
                    font-size: root.small-glyph;
                    width: parent.width;
                    height: self.preferred-height;
                    y: root.marquee-end ? -max(0px, self.height - parent.height) : 0px;
                    wrap: word-wrap;
                    animate y { duration: 1400ms; easing: linear; }
                }
            }
        }

        // ---- bottom bar ---------------------------------------------------
        // The machine on the left, what the buttons do on the right, and
        // the scroll speed in between for a moment after it changes. Not on
        // the wordmark: nothing should sit under a logo.
        if root.bottom-bar-visible: Rectangle {
            x: 0;
            y: parent.height - root.bar-height;
            width: parent.width;
            height: root.bar-height;
            background: root.c-bar;

            // Placed rather than negotiated: in a layout the legend was
            // the thing that gave way and elided, however the spacer was
            // weighted.
            HorizontalLayout {
                x: root.pad;
                y: 0;
                width: parent.width * 30%;
                height: parent.height;
                spacing: root.pad;
                alignment: start;

                Text {
                    text: root.clock;
                    color: root.c-text-dim;
                    font-size: root.bar-glyph;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Drawn rather than written. The glyphs are baked into the
                // binary from the text in this file, and the font behind
                // them has no symbol for either of these, so a character
                // would come out as nothing at all.
                Rectangle {
                    visible: root.wifi;
                    width: root.wifi ? root.bar-font * 1.1 : 0px;
                    height: root.bar-height;
                    // Four bars climbing left to right: signal strength,
                    // which is what the word said and what everything else
                    // on a machine draws.
                    Rectangle {
                        background: root.c-state;
                        width: root.bar-font * 0.14;
                        height: root.bar-font * 0.25;
                        x: 0;
                        y: (parent.height + root.bar-font * 0.7) / 2 - self.height;
                    }
                    Rectangle {
                        background: root.c-state;
                        width: root.bar-font * 0.14;
                        height: root.bar-font * 0.42;
                        x: root.bar-font * 0.24;
                        y: (parent.height + root.bar-font * 0.7) / 2 - self.height;
                    }
                    Rectangle {
                        background: root.c-state;
                        width: root.bar-font * 0.14;
                        height: root.bar-font * 0.58;
                        x: root.bar-font * 0.48;
                        y: (parent.height + root.bar-font * 0.7) / 2 - self.height;
                    }
                    Rectangle {
                        background: root.c-state;
                        width: root.bar-font * 0.14;
                        height: root.bar-font * 0.75;
                        x: root.bar-font * 0.72;
                        y: (parent.height + root.bar-font * 0.7) / 2 - self.height;
                    }
                }
                // The bluetooth rune, as pixels. Drawn rather than written
                // for the same reason, and drawn as a grid because this
                // build has no path support and the symbol is nine pixels
                // tall on the screen it was made for.
                Rectangle {
                    property <length> dot: max(1px, root.bar-font * 0.16);
                    visible: root.bluetooth;
                    width: root.bluetooth ? self.dot * 6 : 0px;
                    height: root.bar-height;
                    for p in [
                        {x: 2, y: 0}, {x: 2, y: 1}, {x: 3, y: 1},
                        {x: 0, y: 2}, {x: 2, y: 2}, {x: 4, y: 2},
                        {x: 1, y: 3}, {x: 2, y: 3}, {x: 3, y: 3},
                        {x: 2, y: 4},
                        {x: 1, y: 5}, {x: 2, y: 5}, {x: 3, y: 5},
                        {x: 0, y: 6}, {x: 2, y: 6}, {x: 4, y: 6},
                        {x: 2, y: 7}, {x: 3, y: 7},
                        {x: 2, y: 8},
                    ]: Rectangle {
                        background: root.c-state;
                        width: parent.dot;
                        height: parent.dot;
                        x: p.x * parent.dot;
                        y: (parent.height - parent.dot * 9) / 2 + p.y * parent.dot;
                    }
                }
            }

            // One literal per form, because the glyphs that end up in the
            // binary are the ones the compiler finds written here. A string
            // built in Rust can ask for an arrow that was never embedded,
            // and a missing glyph draws nothing at all. The word spliced in
            // after the arrows is safe: it is plain ASCII, which every
            // other literal already embeds.
            Text {
                text: root.show-stats
                    ? root.stats
                    : root.screen == 4
                    ? (root.grid-help != ""
                        ? root.grid-help
                        : (root.find-search
                            ? "A Pick   B Back   X Delete   Y Clear"
                            : "A Pick   B Back"))
                    : root.screen == 5
                    ? root.status
                    : root.screen == 6
                    ? "\u{2191}\u{2193} Scroll   B Back"
                    : root.screen == 1
                        ? (root.plain-help != ""
                            ? root.plain-help
                            : root.category-image-picker
                            ? (root.wide-bar
                                ? "\u{2191}\u{2193} Choose   \u{2190}\u{2192} Page   A Select   B Back"
                                : "A Select  B Back")
                            : (root.wide-bar
                                ? "\u{2191}\u{2193} Choose   \u{2190}\u{2192} Change   A Select   B Back"
                                : "\u{2190}\u{2192} Change  A Select  B Back"))
                        : (root.wide-bar
                            ? "\u{2191}\u{2193} Choose   \u{2190}\u{2192} " + root.lr-word
                                + (root.browse-playable ? "   A Play" : "   A Open")
                                + "   B Back   X Actions   Y Menu"
                            : (root.browse-playable ? "A Play" : "A Open")
                                + "  B Back  X Actions  Y Menu");
                color: root.show-stats ? root.c-state : root.c-text;
                font-size: root.bar-glyph;
                x: parent.width * 30%;
                y: 0;
                width: parent.width * 70% - root.pad;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        // The scroll speed, for a moment after it changes. Over everything
        // and sized to its own text, so it confirms the press without
        // moving anything or waiting for anything.


        if root.operation-kind != 0 && !root.operation-details: Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.c-background;
            property <length> line: max(root.small-glyph * 1.5, self.height * 8%);
            Text {
                text: root.operation-title;
                x: root.pad; y: 0px;
                width: parent.width * 64% - root.pad;
                height: parent.line;
                font-size: root.small-glyph;
                color: root.c-text;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.operation-state;
                x: parent.width * 64%; y: 0px;
                width: parent.width * 36% - root.pad;
                height: parent.line;
                font-size: root.small-glyph;
                color: root.c-text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { y: parent.line; height: 1px; width: parent.width; background: root.c-panel; }
            Text {
                text: root.operation-subject;
                x: root.pad; y: parent.height * 12%;
                width: parent.width - root.pad * 2; height: parent.line;
                font-size: root.small-glyph; color: root.c-text;
                vertical-alignment: center; overflow: elide;
            }
            Text {
                text: root.operation-activity;
                x: root.pad; y: parent.height * 22%;
                width: parent.width - root.pad * 2; height: parent.line;
                font-size: root.small-glyph; color: root.c-text;
                vertical-alignment: center; overflow: elide;
            }
            Rectangle {
                x: root.pad; y: parent.height * 35%;
                width: parent.width - root.pad * 2; height: max(4px, parent.height * 3%);
                background: root.c-panel;
                if root.operation-determinate: Rectangle {
                    width: parent.width * min(1, max(0, root.operation-fraction));
                    height: parent.height; background: root.c-accent;
                }
                if !root.operation-determinate: Rectangle {
                    width: parent.width; height: parent.height;
                    for segment in 10: Rectangle {
                        x: parent.width * segment / 10;
                        width: parent.width * 0.04; height: parent.height;
                        background: root.c-accent;
                    }
                }
            }
            Text {
                text: root.operation-progress;
                x: root.pad; y: parent.height * 40%;
                width: parent.width * 80% - root.pad; height: parent.line;
                font-size: root.small-glyph; color: root.c-text;
                vertical-alignment: center; overflow: elide;
            }
            Text {
                text: root.operation-percent;
                x: parent.width * 80%; y: parent.height * 40%;
                width: parent.width * 20% - root.pad; height: parent.line;
                font-size: root.small-glyph; color: root.c-text-dim;
                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
            }
            Text {
                text: root.operation-note;
                x: root.pad; y: parent.height * 49%;
                width: parent.width - root.pad * 2; height: parent.line;
                font-size: root.small-glyph; color: root.c-text-dim;
                vertical-alignment: center; overflow: elide;
            }
            for stat[index] in root.operation-counts: Rectangle {
                x: root.pad + mod(index, 2) * (parent.width - root.pad * 2) / 2;
                y: parent.height * 59% + floor(index / 2) * parent.line;
                width: (parent.width - root.pad * 2) / 2;
                height: parent.line;
                Text {
                    text: stat.label; x: 0px; y: 0px;
                    width: parent.width * 55%; height: parent.height;
                    font-size: root.small-glyph; color: root.c-text-dim;
                    vertical-alignment: center; overflow: elide;
                }
                Text {
                    text: stat.value; x: parent.width * 55%; y: 0px;
                    width: parent.width * 45% - root.pad;
                    height: parent.height; font-size: root.small-glyph; color: root.c-text;
                    horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                }
            }
            Text {
                text: root.operation-problem;
                x: root.pad; y: parent.height * 78%;
                width: parent.width - root.pad * 2;
                height: max(0px, parent.height - self.y - root.bar-height);
                font-size: root.small-glyph; color: root.c-text;
                wrap: word-wrap; overflow: elide;
            }
            Rectangle {
                visible: root.operation-footer-visible;
                y: parent.height - root.bar-height; width: parent.width;
                height: root.bar-height; background: root.c-bar;
                Text {
                    text: root.operation-controls;
                    x: root.pad; width: parent.width - root.pad * 2; height: parent.height;
                    font-size: root.bar-glyph; color: root.c-text;
                    horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                }
            }
        }

        message-panel := Rectangle {
            visible: root.overlay != "" && (root.screen < 2 || root.screen == 5);
            property <bool> index-report: root.operation-kind == 1 && root.operation-details;
            property <bool> has-hint: root.overlay-dismissible && !root.index-active;
            property <float> max-scroll: max(0, (message-text.preferred-height - message-viewport.height) / 1px);
            background: root.c-surface;
            height: self.index-report ? parent.height : root.index-active
                ? min(parent.height - root.pad * 2, max(root.row-height * 7, parent.height * 70%))
                : min(parent.height - root.pad * 2,
                    max(root.row-height * 3, message-text.preferred-height + root.pad * 2
                        + (self.has-hint ? root.bar-height : 0px)));
            y: (parent.height - self.height) / 2;
            Rectangle {
                background: root.c-accent;
                height: 2px;
                y: 0px;
            }
            message-viewport := Rectangle {
                x: root.pad;
                y: root.pad;
                width: parent.width - root.pad * 2;
                height: max(1px, parent.height - root.pad * 2
                    - (message-panel.index-report ? root.bar-height
                        : root.index-active ? root.pad * 2 : message-panel.has-hint ? root.bar-height : 0px));
                clip: true;
                message-text := Text {
                    text: root.overlay;
                    color: root.c-text;
                    font-size: root.body-glyph;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    width: parent.width;
                    height: self.preferred-height;
                    y: max(0px, (parent.height - self.height) / 2)
                        - min(max(0, root.overlay-offset), message-panel.max-scroll) * 1px;
                }
            }
            if message-panel.has-hint || message-panel.index-report: Text {
                text: message-panel.index-report ? root.operation-controls
                    : message-panel.max-scroll > 0 ? "\u{2191}\u{2193} Read   B Close" : "B Close";
                color: root.c-text;
                font-size: root.bar-glyph;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: root.pad;
                y: parent.height - root.pad - root.bar-height;
                width: parent.width - root.pad * 2;
                height: root.bar-height;
            }
            if root.index-active && !message-panel.index-report: Rectangle {
                x: root.pad;
                y: parent.height - root.pad * 2;
                width: parent.width - root.pad * 2;
                height: max(2px, root.pad / 2);
                background: root.c-panel;
                Rectangle {
                    width: parent.width * min(1, max(0, root.index-fraction));
                    height: parent.height;
                    background: root.c-state;
                }
            }
        }
    }

        // Outside the safe area on purpose: the overscan margin is part
        // of the screen too, and a band of grey around the pictures is
        // exactly the still image a screensaver is meant to prevent.
        // The screensaver: a strip of pictures drifting sideways, each
        // one filling the height. Cropped rather than fitted on
        // purpose: letterboxing would leave bands of unchanging grey
        // along the top and bottom, which on a tube is the one thing a
        // screensaver exists to avoid.
        if root.screen == 3: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: #000000;
            clip: true;
            for row[index] in root.rows: Rectangle {
                x: index * root.saver-cell - root.saver-offset;
                y: 0;
                width: root.saver-cell;
                height: parent.height;
                clip: true;

                Image {
                    source: row.cover;
                    visible: row.has-cover;
                    image-fit: cover;
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                }

                // What is being looked at, on the picture and travelling
                // with it. Sized to its own text and cut to the cell, so a
                // long title cannot spill onto the picture beside it.
                Rectangle {
                    visible: row.has-cover && row.title != "";
                    background: root.c-bar;
                    border-radius: 2px;
                    width: Math.min(
                        root.saver-cell - root.pad * 2,
                        caption.preferred-width + root.pad * 2);
                    height: caption.preferred-height + root.pad;
                    x: (parent.width - self.width) / 2;
                    // Along the bottom, clear of the edge: the middle of a
                    // picture is the part worth seeing.
                    y: parent.height - self.height - root.pad * 3;

                    caption := Text {
                        text: row.title;
                        color: root.c-text;
                        font-size: root.small-glyph;
                        x: root.pad;
                        y: root.pad / 2;
                    }
                }
            }
        }


        if root.speed-visible && !root.index-active: Rectangle {
            background: root.c-bar;
            border-radius: 2px;
            width: speed-text.preferred-width + root.pad * 2;
            height: speed-text.preferred-height + root.pad;
            x: root.inset-left
                + (parent.width - root.inset-left - root.inset-right - self.width) / 2;
            y: parent.height - root.inset-bottom - self.height - root.pad
                - (root.show-bar ? root.bar-height : 0px);

            speed-text := Text {
                text: root.speed-badge;
                color: root.c-state;
                font-size: root.small-glyph;
                x: root.pad;
                y: root.pad / 2;
            }
        }


        if root.gallery-title-visible && !root.speed-visible && !root.index-active: Rectangle {
            background: root.c-bar;
            width: Math.min(
                parent.width - root.inset-left - root.inset-right - root.pad * 2,
                gallery-title-text.preferred-width + root.pad * 2);
            height: gallery-title-text.preferred-height + root.pad;
            x: root.inset-left
                + (parent.width - root.inset-left - root.inset-right - self.width) / 2;
            y: parent.height - root.inset-bottom - self.height - root.pad
                - (root.show-bar ? root.bar-height : 0px);

            gallery-title-text := Text {
                text: root.gallery-title;
                color: root.c-text;
                font-size: root.small-glyph;
                x: root.pad;
                y: root.pad / 2;
                width: parent.width - root.pad * 2;
                overflow: elide;
            }
        }
    }
