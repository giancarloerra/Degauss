# Build output
/target/

# Binaries staged for the card; built, not committed.
/deploy/Scripts/.config/degauss/degauss

# Written by Degauss itself: options, and where you were
/settings.toml
/state.toml

# Staged for the card at build time from assets/logos; not committed twice.
/deploy/Scripts/.config/degauss/logos/

# The same for the shipped themes, staged from assets/themes.
/deploy/Scripts/.config/degauss/themes/

# Local working directory, not part of the project.
/internal/
/.claude/

# What macOS leaves behind in any folder opened in Finder. No leading slash,
# so each one matches at every depth rather than only at the root.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100

# ScreenScraper user and developer credentials, when a source checkout is
# run directly. These files must never be committed.
screenscraper.toml
screenscraper-developer.toml
.screenscraper.toml.*.part
